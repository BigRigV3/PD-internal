    local WeaponNamecallHookInstalled = false
    local WeaponNamecallUnpack = table.unpack or unpack

    local function InstallWeaponNamecallHook()
        if WeaponNamecallHookInstalled
            or type(hookmetamethod) ~= "function"
            or type(getnamecallmethod) ~= "function"
        then
            return WeaponNamecallHookInstalled
        end

        local OldNamecall
        local MakeClosure = type(newcclosure) == "function" and newcclosure or function(Callback)
            return Callback
        end

        local Success = pcall(function()
            OldNamecall = hookmetamethod(game, "__namecall", MakeClosure(function(self, ...)
                local Arguments = {...}
                local ArgumentCount = select("#", ...)
                local Method = tostring(getnamecallmethod())

                if Method == "GetAttribute" then
                    if NoSpreadEnabled and Arguments[1] == "AccuracyDeviation" then
                        return 0
                    end
                    if NoDropEnabled and Arguments[1] == "ProjectileDrop" then
                        return 0
                    end
                    if (NoRecoilEnabled or Library.Flags.norecoil == true) and (
                        Arguments[1] == "Recoil"
                        or Arguments[1] == "HRecoilMod"
                        or Arguments[1] == "VRecoilMod"
                    ) then
                        return 0
                    end
                    if Library.Flags.removeweight and (
                        Arguments[1] == "MovementModifer"
                        or Arguments[1] == "MovementModifier"
                        or Arguments[1] == "GearWeight"
                    ) then
                        return 0
                    end
                    if Library.Flags.removeaimrestrictions and Arguments[1] == "BlockADS" then
                        return false
                    end
                elseif Method == "InvokeServer"
                    and InstantReloadEnabled
                    and self.Name == "Reload"
                then
                    Arguments[2] = 0
                elseif Method == "Raycast"
                then
                    local CallerInfo = type(getinfo) == "function" and getinfo(3)
                    local CallerSource = CallerInfo and CallerInfo.short_src
                    local IsBulletCaller = type(CallerSource) == "string"
                        and string.find(CallerSource, "Bullet", 1, true) ~= nil
                    local Traceback = ""
                    if type(debug) == "table" and type(debug.traceback) == "function" then
                        Traceback = debug.traceback()
                    end

                    if IgnoreWaterEnabled and IsBulletCaller and Arguments[3] then
                        pcall(function() Arguments[3].IgnoreWater = true end)
                    end

                    -- Project Delta's instant-bullet implementation extends the
                    -- bullet ray so the projectile reaches its destination
                    -- immediately. Restrict it to the bullet step to avoid
                    -- changing unrelated game raycasts.
                    if (InstantBulletEnabled or Library.Flags.instantbullet == true)
                        and typeof(Arguments[2]) == "Vector3"
                        and (IsBulletCaller or string.find(Traceback, "onStep", 1, true))
                    then
                        Arguments[2] = Arguments[2] * 9e9
                    end
                end

                return OldNamecall(self, WeaponNamecallUnpack(Arguments, 1, ArgumentCount))
            end))
        end)

        WeaponNamecallHookInstalled = Success and type(OldNamecall) == "function"
        return WeaponNamecallHookInstalled
    end

    RestoreWeaponNamecallHook = function()
        InstantReloadEnabled = false
        InstantBulletEnabled = false
        NoRecoilEnabled = false
        NoSpreadEnabled = false
        NoDropEnabled = false
        IgnoreWaterEnabled = false
    end

    InstallWeaponNamecallHook()

    local SilentAimBulletFunction
    local SilentAimOldBulletFunction
    local SilentAimHook
    local SilentAimHookInstalled = false
    local Unpack = table.unpack or unpack

    local function WrapSilentAimHook(Function)
        if type(LPH_NO_VIRTUALIZE) == "function" then
            Function = LPH_NO_VIRTUALIZE(Function)
        end
        if type(newcclosure) == "function" then
            Function = newcclosure(Function)
        end
        return Function
    end

    local function FindBulletFunction()
        local Modules = SilentAimReplicatedStorage:FindFirstChild("Modules")
        local FPS = Modules and Modules:FindFirstChild("FPS")
        local BulletModule = FPS and FPS:FindFirstChild("Bullet")
        if BulletModule then
            local Success, Bullet = pcall(require, BulletModule)
            if Success and type(Bullet) == "table" and type(Bullet.CreateBullet) == "function" then
                return Bullet.CreateBullet
            end
        end

        if type(getgc) == "function" then
            local Success, Garbage = pcall(getgc, true)
            if Success and type(Garbage) == "table" then
                for _, Value in next, Garbage do
                    if type(Value) == "table" and type(rawget(Value, "CreateBullet")) == "function" then
                        return rawget(Value, "CreateBullet")
                    end
                end
            end
        end

        return nil
    end

    local function InstallSilentAimHook()
        if SilentAimHookInstalled or type(hookfunction) ~= "function" then
            return SilentAimHookInstalled
        end

        SilentAimBulletFunction = FindBulletFunction()
        if type(SilentAimBulletFunction) ~= "function" then
            return false
        end

        SilentAimHook = WrapSilentAimHook(function(...)
            local Arguments = {...}
            local ArgumentCount = select("#", ...)
            local TargetPart = SilentAimTargetPart
            if SilentAimEnabled and TargetPart and TargetPart.Parent then
                local AimData = Arguments[5]
                local Origin
                if type(AimData) == "table" and typeof(AimData.Position) == "Vector3" then
                    Origin = AimData.Position
                elseif typeof(AimData) == "CFrame" then
                    Origin = AimData.Position
                end

                if not Origin then
                    local Character = SilentAimLocalPlayer.Character
                    local Head = Character and Character:FindFirstChild("Head")
                    local Camera = Workspace.CurrentCamera
                    Origin = Head and Head.Position or (Camera and Camera.CFrame.Position)
                end

                if Origin then
                    CreateBulletTracer(Origin, TargetPart.Position)
                    Arguments[5] = {
                        CFrame = CFrame.new(Origin, TargetPart.Position),
                        Position = Origin
                    }
                end
            end

            return SilentAimOldBulletFunction(Unpack(Arguments, 1, ArgumentCount))
        end)

        local Success, Original = pcall(function()
            return hookfunction(SilentAimBulletFunction, SilentAimHook)
        end)
        if not Success or type(Original) ~= "function" then
            SilentAimBulletFunction = nil
            SilentAimHook = nil
            return false
        end

        SilentAimOldBulletFunction = Original
        SilentAimHookInstalled = true
        return true
    end

    RestoreSilentAimHook = function()
        if SilentAimHookInstalled
            and type(hookfunction) == "function"
            and SilentAimBulletFunction
            and SilentAimOldBulletFunction
        then
            pcall(function()
                hookfunction(SilentAimBulletFunction, SilentAimOldBulletFunction)
            end)
        end

        SilentAimHookInstalled = false
        SilentAimBulletFunction = nil
        SilentAimOldBulletFunction = nil
        SilentAimHook = nil
    end

    task.spawn(function()
        for _ = 1, 20 do
            if Unloading then
                return
            end
            if InstallSilentAimHook() then
                return
            end
            task.wait(0.5)
        end
    end)
end

