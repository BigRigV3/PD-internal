        ThirdPersonEnabled = true
        ThirdPersonCameraMode = player.CameraMode
        ThirdPersonMinZoomDistance = player.CameraMinZoomDistance
        ThirdPersonMaxZoomDistance = player.CameraMaxZoomDistance
        ThirdPersonMouseLock = player.DevEnableMouseLock
        return
