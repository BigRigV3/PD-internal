    local function ResolveSilentAimPart(Character)
        if not Character then
            return nil
        end

        return Character:FindFirstChild(SilentAimPartName)
            or Character:FindFirstChild("Head")
            or Character:FindFirstChild("HumanoidRootPart")
    end

    local function GetSilentAimTarget()
        if not SilentAimEnabled then
            return nil
        end

        local Camera = workspace.CurrentCamera
        if not Camera then
            return nil
        end

        local MousePosition = SilentAimUserInputService:GetMouseLocation()
        local BestPart
        local BestDistance = SilentAimFOVRadius

        for _, TargetPlayer in ipairs(SilentAimPlayers:GetPlayers()) do
            if TargetPlayer ~= SilentAimLocalPlayer then
                local SameTeam = TargetPlayer.Team == SilentAimLocalPlayer.Team
                    and TargetPlayer.Team ~= nil
                if not SilentAimTeamCheck or not SameTeam then
                    local Character = TargetPlayer.Character
                    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
                    local Part = ResolveSilentAimPart(Character)
                    if Part and Humanoid and Humanoid.Health > 0 then
                        local ScreenPoint, OnScreen = Camera:WorldToViewportPoint(Part.Position)
                        local WorldDistance = (Camera.CFrame.Position - Part.Position).Magnitude / 3.5714285714
                        if OnScreen
                            and ScreenPoint.Z > 0
                            and WorldDistance <= (ESP.MaxDistance or math.huge)
                        then
                            local ScreenDistance = (Vector2.new(ScreenPoint.X, ScreenPoint.Y) - MousePosition).Magnitude
                            if ScreenDistance <= BestDistance then
                                BestPart = Part
                                BestDistance = ScreenDistance
                            end
                        end
                    end
                end
            end
        end

        return BestPart
    end

