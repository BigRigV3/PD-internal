local function UnloadAll()
    if Unloading then
        return
    end

    Unloading = true
    Environment.TypeshitCleanup = nil
    AimbotFOVEnabled = false
    SilentAimEnabled = false
    SilentAimTargetPart = nil
    InstantBulletEnabled = false
    NoRecoilEnabled = false
    AntiAimEnabled = false
    AntiAimUnderground = false
    SkinChangerEnabled = false
    UnlockAllSkinsEnabled = false
    SelfChamsEnabled = false
    ArmChamsEnabled = false
    if ThirdPersonEnabled and SetThirdPersonEnabled then
        pcall(SetThirdPersonEnabled, false)
    end
    ThirdPersonEnabled = false
    if ClearLocalChams then
        pcall(ClearLocalChams)
    end
    SetFOVCircleVisible(false)
    RemoveFOVCircles()

    if TargetIndicator then
        pcall(function()
            TargetIndicator:ResetConnection()
            ResetTargetStatsConnection()
            TargetIndicator:SetVisibility(false)
        end)
    end

    pcall(function()
        ESP:Unload()
    end)
    if RestoreWeaponModsHook then
        pcall(RestoreWeaponModsHook)
    end
    if RestoreSilentAimHook then
        pcall(RestoreSilentAimHook)
    end
    if RestoreWeaponNamecallHook then
        pcall(RestoreWeaponNamecallHook)
    end
    if RestorePlayerMods then
        pcall(RestorePlayerMods)
    end
    pcall(function()
        Library:Exit()
    end)
end

