    local InstantHitHookInstalled = false
    local InstantHitUnpack = table.unpack or unpack

    local function InstallInstantHitHook()
        if InstantHitHookInstalled
            or type(hookmetamethod) ~= "function"
            or type(getnamecallmethod) ~= "function"
        then
            return InstantHitHookInstalled
        end

        local OldNamecall
        local MakeClosure = type(newcclosure) == "function" and newcclosure or function(Callback)
            return Callback
        end

        local Success = pcall(function()
            OldNamecall = hookmetamethod(game, "__namecall", MakeClosure(function(self, ...)
                local Arguments = {...}
                local Method = tostring(getnamecallmethod())
                local TargetPart = SilentAimTargetPart

                if InstantHitEnabled
                    and TargetPart
                    and TargetPart.Parent
                    and Method == "Raycast"
                then
                    local CallerInfo = type(getinfo) == "function" and getinfo(3)
                    local CallerSource = CallerInfo and CallerInfo.short_src
                    if type(CallerSource) == "string" and string.find(CallerSource, "Bullet", 1, true) then
                        local Origin = Arguments[1]
                        if typeof(Origin) == "Vector3" then
                            local Direction = TargetPart.Position - Origin
                            if Direction.Magnitude > 0 then
                                Arguments[2] = Direction.Unit * Direction.Magnitude * 10
                            end
                        end
                    end
                elseif InstantHitEnabled
                    and InstantHitMethod == "invoke"
                    and (Method == "InvokeServer" or Method == "invokeServer")
                    and self.Name == "FireProjectile"
                then
                    local Origin = Arguments[1]
                    if TargetPart
                        and TargetPart.Parent
                        and typeof(Origin) == "Vector3"
                    then
                        local Distance = (TargetPart.Position - Origin).Magnitude
                        task.spawn(function()
                            pcall(function()
                                SilentAimReplicatedStorage.Remotes.ProjectileInflict:FireServer(
                                    TargetPart,
                                    CFrame.new(0, 0.2, -0.2),
                                    Arguments[2],
                                    (tonumber(Arguments[3]) or 0) + Distance * 0.0065
                                )
                            end)
                        end)
                    end
                elseif InstantHitEnabled
                    and InstantHitMethod == "raycast"
                    and (Method == "FireServer" or Method == "fireServer")
                    and self.Name == "ProjectileInflict"
                then
                    Arguments[4] = 0 / 0
                end

                return OldNamecall(self, InstantHitUnpack(Arguments))
            end))
        end)

        InstantHitHookInstalled = Success and type(OldNamecall) == "function"
        return InstantHitHookInstalled
    end

    RestoreInstantHitHook = function()
        InstantHitEnabled = false
    end

    InstallInstantHitHook()

    local SilentAimBulletFunction
    local SilentAimOldBulletFunction
    local SilentAimHook
    local SilentAimHookInstalled = false
    local Unpack = table.unpack or unpack

    local function WrapSilentAimHook(Function)
        if type(LPH_NO_VIRTUALIZE) == "function" then
            Function = LPH_NO_VIRTUALIZE(Function)
        end
        if type(newcclosure) == "function" then
            Function = newcclosure(Function)
        end
        return Function
    end

    local function FindBulletFunction()
        local Modules = SilentAimReplicatedStorage:FindFirstChild("Modules")
        local FPS = Modules and Modules:FindFirstChild("FPS")
        local BulletModule = FPS and FPS:FindFirstChild("Bullet")
        if BulletModule then
            local Success, Bullet = pcall(require, BulletModule)
            if Success and type(Bullet) == "table" and type(Bullet.CreateBullet) == "function" then
                return Bullet.CreateBullet
            end
        end

        if type(getgc) == "function" then
            local Success, Garbage = pcall(getgc, true)
            if Success and type(Garbage) == "table" then
                for _, Value in next, Garbage do
                    if type(Value) == "table" and type(rawget(Value, "CreateBullet")) == "function" then
                        return rawget(Value, "CreateBullet")
                    end
                end
            end
        end

        return nil
    end

    local function InstallSilentAimHook()
        if SilentAimHookInstalled or type(hookfunction) ~= "function" then
            return SilentAimHookInstalled
        end

        SilentAimBulletFunction = FindBulletFunction()
        if type(SilentAimBulletFunction) ~= "function" then
            return false
        end

        SilentAimHook = WrapSilentAimHook(function(...)
            local Arguments = {...}
            local TargetPart = SilentAimTargetPart
            if SilentAimEnabled and TargetPart and TargetPart.Parent then
                local AimData = Arguments[5]
                local Origin
                if type(AimData) == "table" and typeof(AimData.Position) == "Vector3" then
                    Origin = AimData.Position
                elseif typeof(AimData) == "CFrame" then
                    Origin = AimData.Position
                end

                if not Origin then
                    local Character = SilentAimLocalPlayer.Character
                    local Head = Character and Character:FindFirstChild("Head")
                    local Camera = workspace.CurrentCamera
                    Origin = Head and Head.Position or (Camera and Camera.CFrame.Position)
                end

                if Origin then
                    Arguments[5] = {
                        CFrame = CFrame.new(Origin, TargetPart.Position),
                        Position = Origin
                    }
                end
            end

            return SilentAimOldBulletFunction(Unpack(Arguments))
        end)

        local Success, Original = pcall(function()
            return hookfunction(SilentAimBulletFunction, SilentAimHook)
        end)
        if not Success or type(Original) ~= "function" then
            SilentAimBulletFunction = nil
            SilentAimHook = nil
            return false
        end

        SilentAimOldBulletFunction = Original
        SilentAimHookInstalled = true
        return true
    end

    RestoreSilentAimHook = function()
        if SilentAimHookInstalled
            and type(hookfunction) == "function"
            and SilentAimBulletFunction
            and SilentAimOldBulletFunction
        then
            pcall(function()
                hookfunction(SilentAimBulletFunction, SilentAimOldBulletFunction)
            end)
        end

        SilentAimHookInstalled = false
        SilentAimBulletFunction = nil
        SilentAimOldBulletFunction = nil
        SilentAimHook = nil
    end

    task.spawn(function()
        for _ = 1, 20 do
            if Unloading then
                return
            end
            if InstallSilentAimHook() then
                return
            end
            task.wait(0.5)
        end
    end)
end

