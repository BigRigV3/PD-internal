        player.CameraMode = ThirdPersonCameraMode or Enum.CameraMode.LockFirstPerson
        player.CameraMinZoomDistance = ThirdPersonMinZoomDistance or 0
        player.CameraMaxZoomDistance = ThirdPersonMaxZoomDistance or 0
        if ThirdPersonMouseLock ~= nil then
            player.DevEnableMouseLock = ThirdPersonMouseLock
