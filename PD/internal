    local function WrapWeaponModsHook(Function)
        if type(LPH_NO_VIRTUALIZE) == "function" then
            return LPH_NO_VIRTUALIZE(Function)
        end
        return Function
    end

    local function FindFPSGameVars()
        if type(getgc) ~= "function" then
            return nil
        end

        local Success, Garbage = pcall(getgc, true)
        if not Success or type(Garbage) ~= "table" then
            return nil
        end

        for _, Value in next, Garbage do
            if type(Value) == "table" and type(rawget(Value, "updateClient")) == "function" then
                return Value
            end
        end

        return nil
    end

    -- Save values only when an enabled feature actually overrides them.
    local WeaponOverrides = setmetatable({}, {__mode = "k"})

    local function SetWeaponOverride(Object, Property, Enabled, Value)
        if not Object then
            return
        end

        local Saved = WeaponOverrides[Object]
        if Enabled then
            if not Saved then
                Saved = {}
                WeaponOverrides[Object] = Saved
            end
            if not Saved[Property] then
                Saved[Property] = {Value = Object[Property]}
            end
            Object[Property] = Value
        elseif Saved and Saved[Property] then
            Object[Property] = Saved[Property].Value
            Saved[Property] = nil
            if next(Saved) == nil then
                WeaponOverrides[Object] = nil
            end
        end
    end

    local function RestoreWeaponOverrides()
        for Object, Saved in pairs(WeaponOverrides) do
            for Property, Original in pairs(Saved) do
                pcall(function()
                    Object[Property] = Original.Value
                end)
            end
        end
        table.clear(WeaponOverrides)
    end

    local function ApplyWeaponMods(Weapon)
        local Flags = Library.Flags
        local Springs = Weapon.springs

        if type(Flags) ~= "table" or type(Springs) ~= "table" then
            return
        end

        SetWeaponOverride(Weapon, "FireModes", Flags.allfiremode == true, {"Auto", "Semi"})
        SetWeaponOverride(Weapon, "EquipTValue", Flags.instantequip == true, 100)
        SetWeaponOverride(Weapon, "FireRate", Flags.fireratechanger == true, Flags.fireratedelay)

        for _, Property in ipairs({"sprintOffSet", "sprintIdleOffset", "weaponOffSet"}) do
            local Enabled = Flags.modeloffset == true
            local Value
            if Enabled then
                local Saved = WeaponOverrides[Weapon]
                local Original = Weapon[Property]
                if Saved and Saved[Property] then
                    Original = Saved[Property].Value
                end
                local Offset = CFrame.new(
                    tonumber(Flags.modeloffsetx) or 0,
                    tonumber(Flags.modeloffsety) or 0,
                    tonumber(Flags.modeloffsetz) or 0
                )
                Value = (typeof(Original) == "CFrame" and Original or CFrame.new()) * Offset
            end
            SetWeaponOverride(Weapon, Property, Enabled, Value)
        end

        for _, Property in ipairs({"TouchWallPosY", "TouchWallPosZ", "TouchWallRotX", "TouchWallRotY"}) do
            SetWeaponOverride(Weapon, Property, Flags.noobstructions == true, 0)
        end

        local function SetSpring(Spring, Enabled, ResetMotion)
            SetWeaponOverride(Spring, "Force", Enabled, 0)
            SetWeaponOverride(Spring, "Speed", Enabled, 0)
            if ResetMotion then
                SetWeaponOverride(Spring, "Position", Enabled, Vector3.new(0, 0, 0))
                SetWeaponOverride(Spring, "Velocity", Enabled, Vector3.new(0, 0, 0))
            end
        end

        SetSpring(Springs.wallTouchTilt, Flags.noobstructions == true, false)
        SetSpring(Springs.sway, Flags.nosway == true, true)
        SetSpring(Springs.gunSway, Flags.nosway == true, true)
        SetWeaponOverride(Springs.leanAlpha, "Force", Flags.instantlean == true, 50)
        SetWeaponOverride(Springs.leanAlpha, "Speed", Flags.instantlean == true, 50)

        for _, Name in ipairs({"jumpTilt", "walkCycle", "sprintCycle", "strafeTilt"}) do
            SetSpring(Springs[Name], Flags.nobobbing == true, true)
        end

        for _, Name in ipairs({"cameraRecoil", "recoilRot", "recoilPos"}) do
            SetSpring(Springs[Name], Flags.norecoil == true, false)
        end
    end

    local FPSGameVars
    local OldUpdateClient
    local WeaponModsHook
    local WeaponModsHookInstalled = false

    local function InstallWeaponModsHook()
        if WeaponModsHookInstalled then
            return true
        end

        FPSGameVars = FindFPSGameVars()
        OldUpdateClient = FPSGameVars and rawget(FPSGameVars, "updateClient")
        if not FPSGameVars or type(OldUpdateClient) ~= "function" then
            return false
        end

        WeaponModsHook = WrapWeaponModsHook(function(...)
            local Weapon = select(1, ...)

            if type(Weapon) == "table" then
                pcall(ApplyWeaponMods, Weapon)
            end

            return OldUpdateClient(...)
        end)

        local Success = pcall(function()
            FPSGameVars.updateClient = WeaponModsHook
        end)
        if not Success then
            FPSGameVars = nil
            OldUpdateClient = nil
            WeaponModsHook = nil
            return false
        end

        WeaponModsHookInstalled = true
        return true
    end

    RestoreWeaponModsHook = function()
        RestoreWeaponOverrides()
        if FPSGameVars and OldUpdateClient and WeaponModsHook
            and rawget(FPSGameVars, "updateClient") == WeaponModsHook
        then
            pcall(function()
                FPSGameVars.updateClient = OldUpdateClient
            end)
        end

        WeaponModsHookInstalled = false
        FPSGameVars = nil
        OldUpdateClient = nil
        WeaponModsHook = nil
    end

    task.spawn(function()
        for _ = 1, 20 do
            if InstallWeaponModsHook() then
                return
            end
            task.wait(0.5)
        end
    end)
end

