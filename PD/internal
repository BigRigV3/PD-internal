do
    local SkinChangerToggle = ExploitSection:Toggle({
        Name = "skinchanger",
        Flag = "skinchanger",
        Default = false,
        Callback = function(Value)
            SkinChangerEnabled = Value == true
            if ApplySkinSelections then
                ApplySkinSelections()
            end
        end
    })
    local SkinChangerSettings = SkinChangerToggle:Settings()
    local SkinRoot = ReplicatedStorage:FindFirstChild("Skins")
    local SkinPackRoot = ReplicatedStorage:FindFirstChild("SkinPacks")
    local RangedWeapons = ReplicatedStorage:FindFirstChild("RangedWeapons")
    local SkinTypes = {}
    local SkinInventoryItems = {}
    local OriginalInventoryState = {}
    local MeleeNames = {
        "IceDagger", "GoldenDV2", "M9Fade", "IceAxe", "Karambit",
        "PlasmaNinjato", "DV2", "AnarchyTomahawk", "Cutlass", "Scythe", "Greatsword"
    }

    local function AddSkinWeapon(WeaponName, Folder)
        if not Folder or not Folder:IsA("Folder") then
            return
        end

        SkinTypes[WeaponName] = SkinTypes[WeaponName] or {}
        local Existing = {}
        for _, SkinName in ipairs(SkinTypes[WeaponName]) do
            Existing[SkinName] = true
        end

        if not Existing.Default then
            table.insert(SkinTypes[WeaponName], "Default")
            Existing.Default = true
        end

        for _, Skin in ipairs(Folder:GetChildren()) do
            if not Existing[Skin.Name] then
                table.insert(SkinTypes[WeaponName], Skin.Name)
                Existing[Skin.Name] = true
            end
        end

        table.sort(SkinTypes[WeaponName], function(Left, Right)
            if Left == "Default" then
                return true
            end
            if Right == "Default" then
                return false
            end
            return Left < Right
        end)
    end

    for _, Root in ipairs({SkinRoot, SkinPackRoot}) do
        if Root then
            for _, WeaponFolder in ipairs(Root:GetChildren()) do
                AddSkinWeapon(WeaponFolder.Name, WeaponFolder)
            end
        end
    end

    if RangedWeapons then
        for _, Weapon in ipairs(RangedWeapons:GetChildren()) do
            if SkinTypes[Weapon.Name] then
                AddSkinWeapon(Weapon.Name, SkinRoot and SkinRoot:FindFirstChild(Weapon.Name))
            end
        end
    end

    local function ResolveSkinItem(WeaponName, SkinName)
        if SkinName == "Default" then
            local ItemsList = ReplicatedStorage:FindFirstChild("ItemsList")
            return (ItemsList and ItemsList:FindFirstChild(WeaponName))
                or (RangedWeapons and RangedWeapons:FindFirstChild(WeaponName))
        end

        local ItemsList = ReplicatedStorage:FindFirstChild("ItemsList")
        return (ItemsList and ItemsList:FindFirstChild(SkinName))
            or (RangedWeapons and RangedWeapons:FindFirstChild(SkinName))
            or ReplicatedStorage:FindFirstChild(SkinName, true)
    end

    local function FindInventoryItem(Inventory, WeaponName, CandidateNames)
        local Cached = SkinInventoryItems[WeaponName]
        if Cached and Cached.Parent then
            return Cached
        end

        local Names = CandidateNames or {WeaponName}
        for _, Item in ipairs(Inventory:GetDescendants()) do
            if (Item:IsA("ObjectValue") or Item:IsA("StringValue"))
                and table.find(Names, Item.Name)
            then
                SkinInventoryItems[WeaponName] = Item
                return Item
            end
        end

        return nil
    end

    local function ApplyInventorySkin(Inventory, WeaponName, SkinName)
        local InventoryItem = FindInventoryItem(Inventory, WeaponName)
        local SelectedItem = ResolveSkinItem(WeaponName, SkinName)
        if not InventoryItem or not SelectedItem then
            return false
        end

        if not OriginalInventoryState[WeaponName] then
            OriginalInventoryState[WeaponName] = {
                Item = InventoryItem,
                Name = InventoryItem.Name,
                Value = InventoryItem.Value,
            }
        end

        InventoryItem.Name = SkinName
        if InventoryItem:IsA("ObjectValue") then
            InventoryItem.Value = SelectedItem
        elseif InventoryItem:IsA("StringValue") then
            InventoryItem.Value = SkinName
        end

        return true
    end

    local function ApplyMeleeSkin(Inventory, SkinName)
        local InventoryItem = FindInventoryItem(Inventory, "__melee", MeleeNames)
        local SelectedItem = ResolveSkinItem(SkinName, SkinName)
        if not InventoryItem or not SelectedItem then
            return false
        end

        if not OriginalInventoryState.__melee then
            OriginalInventoryState.__melee = {
                Item = InventoryItem,
                Name = InventoryItem.Name,
                Value = InventoryItem.Value,
            }
        end

        InventoryItem.Name = SkinName
        if InventoryItem:IsA("ObjectValue") then
            InventoryItem.Value = SelectedItem
        elseif InventoryItem:IsA("StringValue") then
            InventoryItem.Value = SkinName
        end

        return true
    end

    local function RestoreInventorySkins()
        for WeaponName, State in pairs(OriginalInventoryState) do
            local Item = State.Item
            if Item and Item.Parent then
                pcall(function()
                    Item.Name = State.Name
                    if Item:IsA("ObjectValue") then
                        Item.Value = State.Value
                    elseif Item:IsA("StringValue") then
                        Item.Value = State.Value
                    end
                end)
            end
            SkinInventoryItems[WeaponName] = nil
            OriginalInventoryState[WeaponName] = nil
        end
    end

    ApplySkinSelections = function()
        local PlayerFolder = ReplicatedStorage:FindFirstChild("Players")
        local LocalFolder = PlayerFolder and PlayerFolder:FindFirstChild(player.Name)
        local Inventory = LocalFolder and LocalFolder:FindFirstChild("Inventory")
        if not Inventory then
            return
        end

        if not SkinChangerEnabled then
            RestoreInventorySkins()
            return
        end

        for WeaponName in pairs(SkinTypes) do
            local Enabled = Library.Flags["skin_" .. WeaponName .. "_enabled"]
            local SelectedSkin = Library.Flags["skin_" .. WeaponName]
            if Enabled and type(SelectedSkin) == "string" then
                ApplyInventorySkin(Inventory, WeaponName, SelectedSkin)
            end
        end

        if Library.Flags.skin_melee_enabled and type(Library.Flags.skin_melee) == "string" then
            ApplyMeleeSkin(Inventory, Library.Flags.skin_melee)
        end
    end

    local function CreateSkinOption(WeaponName, SkinItems)
        local Dropdown
        local EnabledFlag = "skin_" .. WeaponName .. "_enabled"
        local SkinFlag = "skin_" .. WeaponName

        SkinChangerSettings:Toggle({
            Name = WeaponName,
            Flag = EnabledFlag,
            Default = false,
            Callback = function(Value)
                if Dropdown then
                    Dropdown:SetVisibility(Value == true)
                end
                ApplySkinSelections()
            end
        })

        Dropdown = SkinChangerSettings:Dropdown({
            Name = "skin",
            Flag = SkinFlag,
            Items = SkinItems,
            Default = SkinItems[1] or "Default",
            Callback = function()
                ApplySkinSelections()
            end
        })
        Dropdown:SetVisibility(false)
    end

    local MeleeDropdown
    local MeleeToggle = SkinChangerSettings:Toggle({
        Name = "Melee",
        Flag = "skin_melee_enabled",
        Default = false,
        Callback = function(Value)
            if MeleeDropdown then
                MeleeDropdown:SetVisibility(Value == true)
            end
            ApplySkinSelections()
        end
    })
    MeleeDropdown = SkinChangerSettings:Dropdown({
        Name = "melee skin",
        Flag = "skin_melee",
        Items = MeleeNames,
        Default = "DV2",
        Callback = function()
            ApplySkinSelections()
        end
    })
    MeleeDropdown:SetVisibility(false)

    for WeaponName, SkinItems in pairs(SkinTypes) do
        CreateSkinOption(WeaponName, SkinItems)
    end

    task.spawn(function()
        while not Unloading do
            task.wait(0.5)
            if SkinChangerEnabled then
                ApplySkinSelections()
            end
        end
    end)
end

