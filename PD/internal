local function LoadScript(Url)
    local Source = nil

    -- raw.githubusercontent can briefly 404/429 after a push, so retry a few times
    for _ = 1, 3 do
        local Ok, Result = pcall(function()
            return game:HttpGet(Url)
        end)

        if Ok and type(Result) == "string" and #Result > 0 and not string.find(Result, "^%d%d%d: ") then
            Source = Result
            break
        end

        task.wait(1)
    end

    assert(Source, "failed to download " .. Url)

    -- The remote esp lib can contain a second, stale copy after the first
    -- `return ESP`. Always execute the first complete copy.
    if string.find(Url, "/esplib$") then
        local FirstReturn = string.find(Source, "\nreturn ESP")
        if FirstReturn then
            Source = string.sub(Source, 1, FirstReturn + #"\nreturn ESP" - 1)
        end
    end

    local Chunk, Error = loadstring(Source)

    assert(Chunk, "failed to compile " .. Url .. ": " .. tostring(Error))

    return Chunk()
end

