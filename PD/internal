    local function CreateBulletTracer(Origin, Position)
        if not BulletTracerEnabled or typeof(Origin) ~= "Vector3" or typeof(Position) ~= "Vector3" then
            return
        end

        local Parent = Workspace:FindFirstChild("NoCollision") or Workspace
