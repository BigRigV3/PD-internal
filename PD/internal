    local function WrapWeaponModsHook(Function)
        if type(LPH_NO_VIRTUALIZE) == "function" then
            return LPH_NO_VIRTUALIZE(Function)
        end
        return Function
    end

    local function FindFPSGameVars()
        if type(getgc) ~= "function" then
            return nil
        end

        local Success, Garbage = pcall(getgc, true)
        if not Success or type(Garbage) ~= "table" then
            return nil
        end

        for _, Value in next, Garbage do
            if type(Value) == "table" and type(rawget(Value, "updateClient")) == "function" then
                return Value
            end
        end

        return nil
    end

    local function ApplyWeaponMods(Weapon)
        local Flags = Library.Flags
        local Springs = Weapon.springs

        if type(Flags) ~= "table" or type(Springs) ~= "table" then
            return
        end

        if Flags.instantaim then
            Weapon.AimInSpeed = 0
            Weapon.AimOutSpeed = 0
        end

        if Flags.allfiremode then
            Weapon.FireModes = {"Auto", "Semi"}
        end

        if Flags.instantequip then
            Weapon.EquipTValue = 100
        end

        if Flags.fireratechanger then
            Weapon.FireRate = Flags.fireratedelay
        end

        if Flags.modeloffset then
            local Offset = CFrame.new(Vector3.new(
                tonumber(Flags.modeloffsetx) or 0,
                tonumber(Flags.modeloffsety) or 0,
                tonumber(Flags.modeloffsetz) or 0
            ))
            Weapon.sprintOffSet = Offset
            Weapon.sprintIdleOffset = Offset
            Weapon.weaponOffSet = Offset
        end

        local WallTouchTilt = Springs.wallTouchTilt
        if Flags.noobstructions then
            Weapon.TouchWallPosY = 0
            Weapon.TouchWallPosZ = 0
            Weapon.TouchWallRotX = 0
            Weapon.TouchWallRotY = 0

            if WallTouchTilt then
                WallTouchTilt.Force = 0
                WallTouchTilt.Speed = 0
            end
        elseif WallTouchTilt then
            WallTouchTilt.Force = 50
            WallTouchTilt.Speed = 4
        end

        local Sway = Springs.sway
        local GunSway = Springs.gunSway
        if Flags.nosway then
            if Sway then
                Sway.Position = Vector3.new(0, 0, 0)
                Sway.Force = 0
                Sway.Speed = 0
            end
            if GunSway then
                GunSway.Position = Vector3.new(0, 0, 0)
                GunSway.Force = 0
                GunSway.Speed = 0
            end
        else
            if Sway then
                Sway.Force = 100
                Sway.Speed = 4
            end
            if GunSway then
                GunSway.Force = 50
                GunSway.Speed = 4
            end
        end

        local LeanAlpha = Springs.leanAlpha
        if LeanAlpha then
            LeanAlpha.Force = 50
            LeanAlpha.Speed = Flags.instantlean and 50 or 4
        end

        local JumpTilt = Springs.jumpTilt
        local WalkCycle = Springs.walkCycle
        local SprintCycle = Springs.sprintCycle
        local StrafeTilt = Springs.strafeTilt
        if Flags.nobobbing then
            if JumpTilt then
                JumpTilt.Position = Vector3.new(0, 0, 0)
                JumpTilt.Force = 0
                JumpTilt.Speed = 0
            end
            if WalkCycle then
                WalkCycle.Position = Vector3.new(0, 0, 0)
                WalkCycle.Force = 0
                WalkCycle.Speed = 0
            end
            if SprintCycle then
                SprintCycle.Position = Vector3.new(0, 0, 0)
                SprintCycle.Force = 0
                SprintCycle.Speed = 0
            end
            if StrafeTilt then
                StrafeTilt.Position = Vector3.new(0, 0, 0)
                StrafeTilt.Force = 0
                StrafeTilt.Speed = 0
            end
        else
            if JumpTilt then
                JumpTilt.Force = 90
                JumpTilt.Speed = 4
            end
            if WalkCycle then
                WalkCycle.Force = 50
                WalkCycle.Speed = 4
            end
            if SprintCycle then
                SprintCycle.Force = 50
                SprintCycle.Speed = 4
            end
            if StrafeTilt then
                StrafeTilt.Force = 50
                StrafeTilt.Speed = 4
            end
        end

        local CameraRecoil = Springs.cameraRecoil
        local RecoilRot = Springs.recoilRot
        local RecoilPos = Springs.recoilPos
        if Flags.norecoil then
            if CameraRecoil then
                CameraRecoil.Force = 0
                CameraRecoil.Speed = 0
            end
            if RecoilRot then
                RecoilRot.Force = 0
                RecoilRot.Speed = 0
            end
            if RecoilPos then
                RecoilPos.Force = 0
                RecoilPos.Speed = 0
            end
        else
            if CameraRecoil then
                CameraRecoil.Force = 100
                CameraRecoil.Speed = 6
            end
            if RecoilRot then
                RecoilRot.Force = 35
                RecoilRot.Speed = 3
            end
            if RecoilPos then
                RecoilPos.Force = 75
                RecoilPos.Speed = 5
            end
        end
    end

    local FPSGameVars
    local OldUpdateClient
    local WeaponModsHook
    local WeaponModsHookInstalled = false
    local Unpack = table.unpack or unpack

    local function InstallWeaponModsHook()
        if WeaponModsHookInstalled then
            return true
        end

        FPSGameVars = FindFPSGameVars()
        OldUpdateClient = FPSGameVars and rawget(FPSGameVars, "updateClient")
        if not FPSGameVars or type(OldUpdateClient) ~= "function" then
            return false
        end

        WeaponModsHook = WrapWeaponModsHook(function(...)
            local Arguments = {...}
            local Weapon = Arguments[1]

            if type(Weapon) == "table" then
                pcall(ApplyWeaponMods, Weapon)
            end

            return OldUpdateClient(Unpack(Arguments))
        end)

        local Success = pcall(function()
            FPSGameVars.updateClient = WeaponModsHook
        end)
        if not Success then
            FPSGameVars = nil
            OldUpdateClient = nil
            WeaponModsHook = nil
            return false
        end

        WeaponModsHookInstalled = true
        return true
    end

    RestoreWeaponModsHook = function()
        if FPSGameVars and OldUpdateClient and WeaponModsHook
            and rawget(FPSGameVars, "updateClient") == WeaponModsHook
        then
            pcall(function()
                FPSGameVars.updateClient = OldUpdateClient
            end)
        end

        WeaponModsHookInstalled = false
        FPSGameVars = nil
        OldUpdateClient = nil
        WeaponModsHook = nil
    end

    task.spawn(function()
        for _ = 1, 20 do
            if InstallWeaponModsHook() then
                return
            end
            task.wait(0.5)
        end
    end)
