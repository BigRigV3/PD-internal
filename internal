    })

    TargetIndicator:SetVisibility(false)

    -- Target indicator follows the closest player inside the aimbot FOV.
    -- This is target selection/visualization only; no aim or camera logic is performed.
    do
        local RunService = game:GetService("RunService")
        local UserInputService = game:GetService("UserInputService")
        local Players = game:GetService("Players")
        local LocalPlayer = Players.LocalPlayer
        CurrentTarget = nil
        local TargetScanAccumulator = 0
        FOVCircle = Instance.new("Frame")
        FOVCircle.Name = "TypeshitFOVCircle"
        FOVCircle.AnchorPoint = Vector2.new(0.5, 0.5)
        FOVCircle.BackgroundTransparency = 1
        FOVCircle.BorderSizePixel = 0
        FOVCircle.Size = UDim2.fromOffset(AimbotFOVRadius * 2, AimbotFOVRadius * 2)
        FOVCircle.ZIndex = 100
        FOVCircle.Parent = Library.Holder.Instance

        local CircleCorner = Instance.new("UICorner")
        CircleCorner.CornerRadius = UDim.new(1, 0)
        CircleCorner.Parent = FOVCircle

        local CircleStroke = Instance.new("UIStroke")
        CircleStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        CircleStroke.Color = Color3.fromRGB(126, 192, 255)
        CircleStroke.Thickness = 1
        CircleStroke.Transparency = 0.1
        CircleStroke.Parent = FOVCircle

        Environment.TypeshitFOVCircle = FOVCircle
        SetFOVCircleVisible(FOVCircleVisible)

        local AimRaycastParams = RaycastParams.new()
        AimRaycastParams.FilterType = Enum.RaycastFilterType.Exclude
        AimRaycastParams.IgnoreWater = true

        local function GetAimTarget()
            local Camera = workspace.CurrentCamera
            local Character = LocalPlayer.Character

            if not Camera or not Character or not AimbotFOVEnabled then
                return nil
            end

            local MouseLocation = UserInputService:GetMouseLocation()
            local BestTarget, BestDistance = nil, AimbotFOVRadius

            for _, Player in ipairs(Players:GetPlayers()) do
                local SameTeam = Player.Team == LocalPlayer.Team and Player.Team ~= nil
                if Player ~= LocalPlayer and (not ESP.TeamCheck or not SameTeam) then
                    local Root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
                    local Humanoid = Player.Character and Player.Character:FindFirstChildOfClass("Humanoid")
                    if Root and Humanoid and Humanoid.Health > 0 then
                        -- Refresh the camera reference immediately before the
                        -- projection; it can be replaced during respawn/cutscenes.
                        local CurrentCamera = workspace.CurrentCamera
                        local Projected, Point, OnScreen = false, nil, false
                        if CurrentCamera then
                            Projected, Point, OnScreen = pcall(function()
                                return CurrentCamera:WorldToViewportPoint(Root.Position)
                            end)
                        end
                        if Projected and Point and CurrentCamera then
                            local Distance = (Vector2.new(Point.X, Point.Y) - MouseLocation).Magnitude
                            local WorldDistance = (CurrentCamera.CFrame.Position - Root.Position).Magnitude / 3.5714285714
                            if OnScreen and Distance <= BestDistance and WorldDistance <= ESP.MaxDistance then
                                BestTarget, BestDistance = Player, Distance
                            end
                        end
                    end
                end
            end

            return BestTarget
        end

        Library:Connect(RunService.RenderStepped, function(DeltaTime)
            if FOVCircle then
                local Success = pcall(function()
                    local MouseLocation = UserInputService:GetMouseLocation()
                    FOVCircle.Position = UDim2.fromOffset(MouseLocation.X, MouseLocation.Y)
                    FOVCircle.Size = UDim2.fromOffset(AimbotFOVRadius * 2, AimbotFOVRadius * 2)
                    FOVCircle.Visible = FOVCircleVisible
                end)

                if not Success then
                    RemoveFOVCircles()
                end
            end

            TargetScanAccumulator = TargetScanAccumulator + DeltaTime
            if TargetScanAccumulator < 0.05 then
                return
            end
            TargetScanAccumulator = TargetScanAccumulator % 0.05

            local NewTarget = GetAimTarget()

            if NewTarget ~= CurrentTarget then
                CurrentTarget = NewTarget

                if NewTarget then
                    TargetIndicator:SetVisibility(TargetIndicatorEnabled)

                    task.spawn(function()
                        -- SetTarget fetches a thumbnail, so keep it off the render step and
                        -- make sure it is still the current target by the time it resolves
                        if CurrentTarget == NewTarget then
                            pcall(function()
                                TargetIndicator:SetTarget(NewTarget)
                            end)
                        end
                    end)
                else
                    -- nothing aimed at: stop the target connections and hide the
                    -- indicator instead of showing yourself
                    TargetIndicator:ResetConnection()
                    TargetIndicator:SetVisibility(false)
                end
            end
        end)
    end
end

do
    local RunService = game:GetService("RunService")
    local Stats = game:GetService("Stats")
    local Elapsed = 0
    local FrameCount = 0

    local function GetWatermarkPing()
        local Success, Ping = pcall(function()
            local Network = Stats:FindFirstChild("Network")
            local ServerStatsItem = Network and Network:FindFirstChild("ServerStatsItem")
            local DataPing = ServerStatsItem and ServerStatsItem:FindFirstChild("Data Ping")

            if not DataPing then
                return nil
            end

            local ValueString = DataPing:GetValueString()
            return tonumber(string.match(ValueString, "%d+"))
        end)

        return Success and Ping or nil
    end

    Library:Connect(RunService.RenderStepped, function(DeltaTime)
        Elapsed = Elapsed + DeltaTime
        FrameCount = FrameCount + 1

        if Elapsed < 0.5 then
            return
        end

        WatermarkFPS = math.floor(FrameCount / Elapsed + 0.5)
        WatermarkPing = GetWatermarkPing()
        Elapsed = 0
        FrameCount = 0

        UpdateWatermark()
    end)

    UpdateWatermark()
end

local Unloading = false
local function UnloadAll()
    if Unloading then
        return
    end

    Unloading = true
    Environment.TypeshitCleanup = nil
    AimbotFOVEnabled = false
    SetFOVCircleVisible(false)
    RemoveFOVCircles()

    if TargetIndicator then
        pcall(function()
            TargetIndicator:ResetConnection()
            TargetIndicator:SetVisibility(false)
        end)
    end

    pcall(function()
        ESP:Unload()
    end)
    pcall(function()
        Library:Exit()
    end)
end

