local function SetWatermarkItemVisibility(ItemName, Value)
    local Item = Watermark and Watermark.Items and Watermark.Items[ItemName]
    if not Item or not Item.Instance then
        return
    end

    pcall(function()
        Item.Instance.Visible = Value == true
    end)
end

local function UpdateWatermark()
    if not Watermark then
        return
    end

    local SubText = { }

    if WatermarkFeatures.version then
        table.insert(SubText, "developer | Beta")
    end

    if WatermarkFeatures.fps then
        table.insert(SubText, string.format("%d fps", WatermarkFPS))
    end

    if WatermarkFeatures.ping then
        table.insert(SubText, string.format("%s ms", WatermarkPing and tostring(WatermarkPing) or "--"))
    end

    SetWatermarkItemVisibility("Title", WatermarkFeatures.name)
    SetWatermarkItemVisibility("SubText", #SubText > 0)
    Watermark:SetSubText(table.concat(SubText, " | "))
end

local function RemoveDrawingObject(Object)
    if not Object then
        return
    end

    pcall(function()
        Object.Visible = false
    end)
    pcall(function()
        Object:Remove()
    end)
    pcall(function()
        Object:Destroy()
    end)
end

local function RemoveFOVCircles()
    RemoveDrawingObject(FOVCircle)
    RemoveDrawingObject(Environment.TypeshitFOVCircle)

    if ESP and type(ESP.Fovcircle) == "table" then
        for _, Circle in pairs(ESP.Fovcircle) do
            RemoveDrawingObject(Circle)
        end
        table.clear(ESP.Fovcircle)
    end

    FOVCircle = nil
    Environment.TypeshitFOVCircle = nil
end

