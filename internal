do
    local Watermark = Window:Watermark({
        Name = "Onix.lol Private",
        SubName = "Project Delta"
    })

    local KeybindList = Window:KeybindList({
        Name = 'hot<font color="rgb(126, 192, 255)">keys</font>'
    })

    local StaffList = Window:StaffList({
        Name = 'staff<font color="rgb(0, 80, 255)"> list</font>'
    })

    StaffList:Add("Bigrig", "owner/dev")

    local TargetIndicator = Window:TargetIndicator({
        Name = "target<font color='rgb(0, 80, 255)'> info</font>"
    })

    TargetIndicator:SetVisibility(false)

    -- target indicator shows whoever the local player is looking at
    do
        local RunService = game:GetService("RunService")
        local UserInputService = game:GetService("UserInputService")
        local Players = game:GetService("Players")
        local LocalPlayer = Players.LocalPlayer
        local CurrentTarget = nil

        local AimRaycastParams = RaycastParams.new()
        AimRaycastParams.FilterType = Enum.RaycastFilterType.Exclude
        AimRaycastParams.IgnoreWater = true

        local function GetAimTarget()
            local Camera = workspace.CurrentCamera
            local Character = LocalPlayer.Character

            if not Camera or not Character then
                return nil
            end

            AimRaycastParams.FilterDescendantsInstances = {Character}

            local MouseLocation = UserInputService:GetMouseLocation()
            local MouseRay = Camera:ViewportPointToRay(MouseLocation.X, MouseLocation.Y)
            local RayResult = workspace:Raycast(MouseRay.Origin, MouseRay.Direction * 512, AimRaycastParams)

            if not RayResult then
                return nil
            end

            if (RayResult.Position - Camera.CFrame.Position).Magnitude / 3.5714285714 > ESP.MaxDistance then
                return nil
            end

            local AimInstance = RayResult.Instance

            while AimInstance and AimInstance ~= workspace do
                local AimPlayer = Players:GetPlayerFromCharacter(AimInstance)

                if AimPlayer and AimPlayer ~= LocalPlayer then
                    return AimPlayer
                end

                AimInstance = AimInstance.Parent
            end

            return nil
        end

        Library:Connect(RunService.RenderStepped, function()
            local NewTarget = GetAimTarget()

            if NewTarget ~= CurrentTarget then
                CurrentTarget = NewTarget

                if NewTarget then
                    TargetIndicator:SetVisibility(true)

                    task.spawn(function()
                        -- SetTarget fetches a thumbnail, so keep it off the render step and
                        -- make sure it is still the current target by the time it resolves
                        if CurrentTarget == NewTarget then
                            pcall(function()
                                TargetIndicator:SetTarget(NewTarget)
                            end)
                        end
                    end)
                else
                    -- nothing aimed at: stop the target connections and hide the
                    -- indicator instead of showing yourself
                    TargetIndicator:ResetConnection()
                    TargetIndicator:SetVisibility(false)
                end
            end
        end)
    end
end

