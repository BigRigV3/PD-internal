do -- server
    local Copy = setclipboard or toclipboard

    local ServerSection = MiscPage:Section({Name = "server", Side = 2}) do
        ServerSection:Button({
            Name = "copy server id",
            Callback = function()
                if not Copy then
                    return
                end

                -- lua code that joins the copied game and server when executed
                Copy(string.format(
                    'game:GetService("TeleportService"):TeleportToPlaceInstance(%d, "%s", game:GetService("Players").LocalPlayer)',
                    game.PlaceId,
                    game.JobId
                ))

                Library:Notification{Name = "copied server join code", Time = 3}
            end
        })

        ServerSection:Button({
            Name = "copy game id",
            Callback = function()
                if not Copy then
                    return
                end

                Copy(tostring(game.PlaceId))

                Library:Notification{Name = "copied game id", Time = 3}
            end
        })
    end
end

