local function UnloadAll()
    if Unloading then
        return
    end
    Unloading = true
    Environment.TypeshitCleanup = nil
    SelfChamsEnabled = false
    ArmChamsEnabled = false
    if ClearLocalChams then
        pcall(ClearLocalChams)
    end
    ClearZombieESP()
    CurrentTarget = nil
    if TargetIndicator then
        pcall(function()
            TargetIndicator:ResetConnection()
            TargetIndicator:SetVisibility(false)
        end)
    end
    SetFOVCircleVisible(false)
    if FOVCircle then
        pcall(function()
            FOVCircle:Destroy()
        end)
        FOVCircle = nil
    end
    pcall(function()
        ESP:Unload()
    end)
    pcall(function()
        Library:Exit()
    end)
end

Environment.TypeshitCleanup = UnloadAll

