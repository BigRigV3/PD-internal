SetFreecamEnabled = function(Value)
    Value = Value == true
    local Camera = workspace.CurrentCamera
    local Character = player.Character
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")

    if not Value and not FreecamEnabled and not FreecamCameraType and not FreecamCameraSubject then
        return
    end

    if Value then
        if FreecamEnabled or not Camera or not UpdateFreecam then
            return
        end

        FreecamEnabled = true
        FreecamCameraType = Camera.CameraType
        FreecamCameraSubject = Camera.CameraSubject
        FreecamMouseBehavior = FreecamUserInputService.MouseBehavior
        pcall(function()
            FreecamReplicationFocus = player.ReplicationFocus
        end)
        FreecamPosition = Camera.CFrame.Position
        FreecamPitch, FreecamYaw = Camera.CFrame:ToOrientation()
        Camera.CameraType = Enum.CameraType.Scriptable
        FreecamUserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
        if not FreecamBound and not FreecamRenderConnection then
            local Bound = pcall(function()
                FreecamRunService:BindToRenderStep(
                    FreecamBindName,
                    Enum.RenderPriority.Camera.Value + 1,
                    UpdateFreecam
                )
            end)

            if Bound then
                FreecamBound = true
            else
                FreecamRenderConnection = FreecamRunService.RenderStepped:Connect(UpdateFreecam)
            end
        end
        return
    end

    FreecamEnabled = false
    if FreecamBound then
        FreecamRunService:UnbindFromRenderStep(FreecamBindName)
        FreecamBound = false
    end
    if FreecamRenderConnection then
        FreecamRenderConnection:Disconnect()
        FreecamRenderConnection = nil
    end
    FreecamPosition = nil
    local RestoreSubject = FreecamCameraSubject
    if Camera then
        Camera.CameraType = FreecamCameraType or Enum.CameraType.Custom

        if RestoreSubject and RestoreSubject.Parent then
            Camera.CameraSubject = RestoreSubject
        else
            local Humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
            if Humanoid then
                Camera.CameraSubject = Humanoid
            end
        end
    end
    FreecamCameraType = nil
    FreecamCameraSubject = nil
    FreecamUserInputService.MouseBehavior = FreecamMouseBehavior or Enum.MouseBehavior.Default
    FreecamMouseBehavior = nil
    pcall(function()
        player.ReplicationFocus = FreecamReplicationFocus
    end)
    FreecamReplicationFocus = nil
    if Root then
        Root.Anchored = false
    end
end

