    local CircleStroke = Instance.new("UIStroke")
    CircleStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    CircleStroke.Color = Color3.fromRGB(126, 192, 255)
    CircleStroke.Thickness = 1
    CircleStroke.Transparency = 0.1
    CircleStroke.Parent = FOVCircle
    SetFOVCircleVisible(FOVCircleVisible)

    local function GetAimTarget()
        local Camera = workspace.CurrentCamera
        if not Camera or not AimbotFOVEnabled then
            return nil
        end

        local MouseLocation = UserInputService:GetMouseLocation()
        local BestTarget, BestDistance = nil, AimbotFOVRadius

        for _, Player in ipairs(Players:GetPlayers()) do
            local SameTeam = Player.Team == LocalPlayer.Team and Player.Team ~= nil
            if Player ~= LocalPlayer and (not ESP.TeamCheck or not SameTeam) then
                local Character = Player.Character
                local Root = Character and Character:FindFirstChild("HumanoidRootPart")
                local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
                if Root and Humanoid and Humanoid.Health > 0 then
                    local Point, OnScreen = Camera:WorldToViewportPoint(Root.Position)
                    local WorldDistance = (Camera.CFrame.Position - Root.Position).Magnitude
                    local ScreenDistance = (Vector2.new(Point.X, Point.Y) - MouseLocation).Magnitude
                    if OnScreen and Point.Z > 0
                        and ScreenDistance <= BestDistance
                        and WorldDistance <= (ESP.MaxDistance * 3.5714285714)
                    then
                        BestTarget, BestDistance = Player, ScreenDistance
                    end
                end
            end
        end

        return BestTarget
    end

    Library:Connect(RunService.RenderStepped, function(DeltaTime)
        local MouseLocation = UserInputService:GetMouseLocation()
        FOVCircle.Position = UDim2.fromOffset(MouseLocation.X, MouseLocation.Y)

        if LastFOVCircleRadius ~= AimbotFOVRadius then
            LastFOVCircleRadius = AimbotFOVRadius
            FOVCircle.Size = UDim2.fromOffset(AimbotFOVRadius * 2, AimbotFOVRadius * 2)
        end

        if FOVCircle.Visible ~= FOVCircleVisible then
            FOVCircle.Visible = FOVCircleVisible
        end

        TargetScanAccumulator = TargetScanAccumulator + DeltaTime
        if TargetScanAccumulator < 0.1 then
            return
        end
        TargetScanAccumulator = TargetScanAccumulator % 0.1

        local NewTarget = GetAimTarget()
        if NewTarget == CurrentTarget then
            return
        end

        CurrentTarget = NewTarget
        if not NewTarget then
            TargetIndicator:ResetConnection()
            TargetIndicator:SetVisibility(false)
            return
        end

        TargetIndicator:SetStatus("targeting")
        TargetIndicator:SetVisibility(TargetIndicatorEnabled)
        task.spawn(function()
            if CurrentTarget == NewTarget then
                pcall(function()
                    TargetIndicator:SetTarget(NewTarget)
                end)
            end
        end)
    end)
end

do
    local RunService = game:GetService("RunService")
    local Stats = game:GetService("Stats")
    local Elapsed = 0
    local FrameCount = 0

    local function GetWatermarkPing()
        local Success, Ping = pcall(function()
            local Network = Stats:FindFirstChild("Network")
            local ServerStatsItem = Network and Network:FindFirstChild("ServerStatsItem")
            local DataPing = ServerStatsItem and ServerStatsItem:FindFirstChild("Data Ping")
            if not DataPing then
                return nil
            end
            return tonumber(string.match(DataPing:GetValueString(), "%d+"))
        end)
        return Success and Ping or nil
    end

    Library:Connect(RunService.RenderStepped, function(DeltaTime)
        Elapsed = Elapsed + DeltaTime
        FrameCount = FrameCount + 1
        if Elapsed < 0.5 then
            return
        end

        WatermarkFPS = math.floor(FrameCount / Elapsed + 0.5)
        WatermarkPing = GetWatermarkPing()
        Elapsed = 0
        FrameCount = 0
        UpdateWatermark()
    end)

    UpdateWatermark()
end

