                table.insert(validTargets, target)
            end
        end

        for i, target in ipairs(validTargets) do
            local angle = ((i - 1) / #validTargets) * math.pi * 2

            local offset = Vector3.new(
                math.cos(angle) * radius,
                0,
                math.sin(angle) * radius
