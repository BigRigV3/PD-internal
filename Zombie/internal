        end

        if type(Flags.esp_enemy_chams) == "boolean" then
            ESP.Drawing.Chams.Enabled = Flags.esp_enemy_chams
        end
        if type(Flags.esp_thermal) == "boolean" then
            ESP.Drawing.Chams.Thermal = Flags.esp_thermal
        end
        if type(Flags.esp_occlusion) == "string" then
            local Occluded = Flags.esp_occlusion == "occluded"
            ESP.Drawing.Chams.VisibleCheck = Occluded
            ESP.Drawing.Chams.Mode = Occluded and "VisibleOnly" or "VisibleAndHidden"
        end
        if type(Flags.esp_chams_fill_transparency) == "number" then
            ESP.Drawing.Chams.Fill_Transparency = Flags.esp_chams_fill_transparency
        end
        if type(Flags.esp_chams_outline_transparency) == "number" then
            ESP.Drawing.Chams.Outline_Transparency = Flags.esp_chams_outline_transparency
        end
    end

    SyncESPFromMenu()
    Library:Connect(game:GetService("RunService").RenderStepped, function(DeltaTime)
        ESPMenuRefresh = ESPMenuRefresh + DeltaTime
        if ESPMenuRefresh < 0.1 then
            return
        end

        ESPMenuRefresh = 0
        SyncESPFromMenu()
    end)
