do -- configs
    local ConfigsSection = MiscPage:Section({Name = "configs", Side = 2})
        local ConfigsFolder = Library.Directory .. Library.Folders.Configs .. "/"
        local ConfigSelected
        local ConfigName

        local function HasFileApi()
            return type(isfile) == "function"
                and type(readfile) == "function"
                and type(writefile) == "function"
                and type(delfile) == "function"
        end

        local function IsSafeConfigName(Name)
            return type(Name) == "string"
                and Name ~= ""
                and not string.find(Name, "[/\\\\]")
                and not string.find(Name, "%.%.")
        end

        local ConfigsDropdown = ConfigsSection:Dropdown({
            Name = "configs",
            Flag = "configs_dropdown",
            Items = { },
            Multi = false,
            Callback = function(Value)
                ConfigSelected = Value
            end
        })

        ConfigsSection:Textbox({
            Flag = "config_name",
            Placeholder = "",
            Callback = function(Value)
                ConfigName = Value
            end
        })

        ConfigsSection:Button({
            Name = "create",
            Callback = function()
                if not HasFileApi() then
                    Library:Notification{Name = "file API unavailable", Time = 3}
                    return
                end

                if not IsSafeConfigName(ConfigName) then
                    Library:Notification{Name = "invalid config name", Time = 3}
                    return
                end

                local Success, Error = pcall(function()
                    local Config = Library:GetConfig()
                    assert(type(Config) == "string", "failed to serialize config")
                    writefile(ConfigsFolder .. ConfigName .. ".json", Config)
                    Library:GetConfigsList(ConfigsDropdown)
                end)

                if Success then
                    Library:Notification{Name = "created config successfully", Time = 3}
                else
                    Library:Notification{Name = "failed to create config: " .. tostring(Error), Time = 3}
                end
            end
        })

        ConfigsSection:Button({
            Name = "delete",
            Callback = function()
                if not HasFileApi() or type(ConfigSelected) ~= "string" then
                    return
                end

                local Path = ConfigsFolder .. ConfigSelected .. ".json"
                if not isfile(Path) then
                    return
                end

                local Success, Error = pcall(function()
                    delfile(Path)
                    Library:GetConfigsList(ConfigsDropdown)
                end)

                if Success then
                    Library:Notification{Name = "deleted config successfully", Time = 3}
                else
                    Library:Notification{Name = "failed to delete config: " .. tostring(Error), Time = 3}
                end
            end
        })

        ConfigsSection:Button({
            Name = "load",
            Callback = function()
                if not HasFileApi() or type(ConfigSelected) ~= "string" then
                    return
                end

                local Path = ConfigsFolder .. ConfigSelected .. ".json"
                if not isfile(Path) then
                    return
                end

                local Success, Error = pcall(function()
                    local ConfigContent = readfile(Path)
                    local Loaded, LoadError = Library:LoadConfig(ConfigContent)
                    assert(Loaded, LoadError or "unknown config error")
                end)

                if Success then
                    Library:Notification{Name = "loaded config successfully", Time = 3}
                else
                    Library:Notification{Name = "failed to load config: " .. tostring(Error), Time = 3}
                end
            end
        })

        ConfigsSection:Button({
            Name = "save",
            Callback = function()
                if not HasFileApi() or type(ConfigSelected) ~= "string" then
                    return
                end

                local Path = ConfigsFolder .. ConfigSelected .. ".json"
                if not isfile(Path) then
                    return
                end

                local Success, Error = pcall(function()
                    local Config = Library:GetConfig()
                    assert(type(Config) == "string", "failed to serialize config")
                    writefile(Path, Config)
                end)

                if Success then
                    Library:Notification{Name = "saved config successfully", Time = 3}
                else
                    Library:Notification{Name = "failed to save config: " .. tostring(Error), Time = 3}
                end
            end
        })

        ConfigsSection:Button({
            Name = "refresh",
            Callback = function()
                Library:GetConfigsList(ConfigsDropdown)
            end
        })

        pcall(function()
            Library:GetConfigsList(ConfigsDropdown)
        end)
end
