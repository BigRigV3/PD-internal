    -- Keep the ESP object synchronized with the UI flags as well as the
    -- individual callbacks. This also makes loaded configs apply reliably.
    local ESPMenuRefresh = 0
    local function SyncESPFromMenu()
        local Flags = Library.Flags

        if type(Flags.esp_enabled) == "boolean" then
            ESP.Enabled = Flags.esp_enabled
        end
        if type(Flags.esp_team_check) == "boolean" then
            ESP.TeamCheck = Flags.esp_team_check
        end
        if type(Flags.esp_self) == "boolean" then
            ESP.SelfCheck = Flags.esp_self
        end
        if type(Flags.esp_fade_distance) == "boolean" then
            ESP.FadeOut.OnDistance = Flags.esp_fade_distance
        end
        if type(Flags.esp_friend_tag) == "boolean" then
            ESP.Options.Friendcheck = Flags.esp_friend_tag
        end

        if type(Flags.esp_max_distance) == "number" then
            ESP.MaxDistance = Flags.esp_max_distance
        end
        if type(Flags.esp_update_rate) == "number" then
            ESP.UpdateRate = Flags.esp_update_rate
        end
        if type(Flags.esp_font_size) == "number" then
            ESP.FontSize = Flags.esp_font_size
        end

        if type(Flags.esp_corner_box) == "boolean" then
            ESP.Drawing.Boxes.Corner.Enabled = Flags.esp_corner_box
        end
        if type(Flags.esp_box_outline) == "boolean" then
            ESP.Drawing.Boxes.Full.Enabled = Flags.esp_box_outline
        end
        if type(Flags.esp_filled_box) == "boolean" then
            ESP.Drawing.Boxes.Filled.Enabled = Flags.esp_filled_box
        end
        if type(Flags.esp_box_outline_mode) == "string" then
            ESP.Drawing.Boxes.Gradient = Flags.esp_box_outline_mode == "gradient"
        end
        if type(Flags.esp_box_fill_mode) == "string" then
            ESP.Drawing.Boxes.GradientFill = Flags.esp_box_fill_mode == "gradient"
        end
        if type(Flags.esp_fill_transparency) == "number" then
            ESP.Drawing.Boxes.Filled.Transparency = Flags.esp_fill_transparency
        end
        if type(Flags.esp_fill_animation) == "boolean" then
            ESP.Drawing.Boxes.Animate = Flags.esp_fill_animation
        end
        if type(Flags.esp_rotation_speed) == "number" then
            ESP.Drawing.Boxes.RotationSpeed = Flags.esp_rotation_speed
        end

        if type(Flags.esp_names) == "boolean" then
            ESP.Drawing.Names.Enabled = Flags.esp_names
        end
        if type(Flags.esp_distance) == "boolean" then
            ESP.Drawing.Distances.Enabled = Flags.esp_distance
        end
        if type(Flags.esp_flags) == "boolean" then
            ESP.Drawing.Flags.Enabled = Flags.esp_flags
        end
        if type(Flags.esp_distance_position) == "string" then
            ESP.Drawing.Distances.Position = Flags.esp_distance_position
        end
        if type(Flags.weapon_text) == "boolean" then
            ESP.Drawing.Weapons.Enabled = Flags.weapon_text
        end
        if type(Flags.weapon_icons) == "boolean" then
            ESP.Drawing.Weapons.Icons = Flags.weapon_icons
        end
        if type(Flags.esp_weapon_gradient) == "boolean" then
            ESP.Drawing.Weapons.Gradient = Flags.esp_weapon_gradient
        end

        if type(Flags.esp_health_bar) == "boolean" then
            ESP.Drawing.Healthbar.Enabled = Flags.esp_health_bar
        end
        if type(Flags.esp_health_text) == "boolean" then
            ESP.Drawing.Healthbar.HealthText = Flags.esp_health_text
        end
        if type(Flags.esp_health_lerp) == "boolean" then
            ESP.Drawing.Healthbar.Lerp = Flags.esp_health_lerp
        end
        if type(Flags.esp_health_gradient) == "boolean" then
