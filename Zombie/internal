UpdateFreecam = function(DeltaTime)
    if not FreecamEnabled then
        return
    end

    local Camera = workspace.CurrentCamera
    if not Camera then
        return
    end

    if not FreecamPosition then
        FreecamPosition = Camera.CFrame.Position
        FreecamPitch, FreecamYaw = Camera.CFrame:ToOrientation()
    end

    Camera.CameraType = Enum.CameraType.Scriptable
    FreecamUserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
    local MouseDelta = FreecamUserInputService:GetMouseDelta()
    FreecamPitch = math.clamp(FreecamPitch - MouseDelta.Y * 0.005, -math.pi / 2 + 0.01, math.pi / 2 - 0.01)
    FreecamYaw = FreecamYaw - MouseDelta.X * 0.005

    local Rotation = CFrame.Angles(0, FreecamYaw, 0) * CFrame.Angles(FreecamPitch, 0, 0)
    local Forward = Rotation.LookVector
    local Right = Rotation.RightVector
    local Direction = Vector3.new(0, 0, 0)

    if FreecamUserInputService:IsKeyDown(Enum.KeyCode.W) then
        Direction = Direction + Forward
    end
    if FreecamUserInputService:IsKeyDown(Enum.KeyCode.S) then
        Direction = Direction - Forward
    end
    if FreecamUserInputService:IsKeyDown(Enum.KeyCode.D) then
        Direction = Direction + Right
    end
    if FreecamUserInputService:IsKeyDown(Enum.KeyCode.A) then
        Direction = Direction - Right
    end
    if FreecamUserInputService:IsKeyDown(Enum.KeyCode.Space) then
        Direction = Direction + Vector3.new(0, 1, 0)
    end
    if FreecamUserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
        Direction = Direction - Vector3.new(0, 1, 0)
    end

    if Direction.Magnitude > 0 then
        Direction = Direction.Unit
    end

    local Speed = FreecamUserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
        and FreecamSpeed / 10
        or FreecamSpeed
    FreecamPosition = FreecamPosition + Direction * DeltaTime * Speed
    Camera.CFrame = CFrame.new(FreecamPosition) * Rotation
end

local function StartUnlockAllSkins()
    if UnlockAllSkinsStarted then
        return
    end

    UnlockAllSkinsStarted = true

    task.spawn(function()
        pcall(function()
            local FunctionLibrary = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("FunctionLibraryExtension"))
            if not FunctionLibrary then
                return
            end

            if FunctionLibrary.IsItemAccessibleToPlayer then
                local OldIsItemAccessible = FunctionLibrary.IsItemAccessibleToPlayer
                FunctionLibrary.IsItemAccessibleToPlayer = function(self, ...)
                    if UnlockAllSkinsEnabled then
                        return true
                    end
                    return OldIsItemAccessible(self, ...)
                end
            end

            if FunctionLibrary.FindDeepAncestor then
                FunctionLibrary.FindDeepAncestor = function(self, InstanceValue, ClassName, Options)
                    local Depth = 0
                    if not InstanceValue or typeof(InstanceValue) ~= "Instance" then
                        return InstanceValue
                    end

                    while InstanceValue and InstanceValue.Parent and InstanceValue.Parent.ClassName == ClassName do
                        if InstanceValue.Parent.Parent
                            and InstanceValue.Parent.Parent.Parent
                            and InstanceValue.Parent.Parent.Parent.Name == "Attachments"
                        then
                            InstanceValue = InstanceValue.Parent.Parent.Parent
                        else
                            InstanceValue = InstanceValue.Parent
                        end

                        Depth = Depth + 1
                        if Options and type(Options) == "table" and Options.SearchForInteraction
                            and InstanceValue:GetAttribute(Options.SearchForInteraction)
                        then
                            break
                        end

                        if Depth > 10
                            or InstanceValue:FindFirstChild("DeepAncestorBreak")
                            or InstanceValue:FindFirstChild("Moving")
                        then
                            break
                        end
                    end

                    return InstanceValue
                end
            end
        end)

        if type(hookmetamethod) == "function" and type(getnamecallmethod) == "function" then
            pcall(function()
                local OldNamecall
                local MakeClosure = type(newcclosure) == "function" and newcclosure or function(Callback)
                    return Callback
                end
                OldNamecall = hookmetamethod(game, "__namecall", MakeClosure(function(self, ...)
                    local Method = tostring(getnamecallmethod())
                    if UnlockAllSkinsEnabled
                        and (Method == "FireServer" or Method == "fireServer"
                            or Method == "InvokeServer" or Method == "invokeServer")
                        and self.Name == "ChangeSkin"
                    then
                        local Arguments = {...}
                        local Weapon = Arguments[1]
                        local SkinName = Arguments[2]
                        if Weapon and typeof(Weapon) == "Instance" then
                            pcall(function()
                                Weapon:SetAttribute("SpoofedSkin", tostring(SkinName) == "Default" and "" or tostring(SkinName))
                            end)
                            return true
                        end
                    end

                    return OldNamecall(self, ...)
                end))
            end)
        end
    end)

    task.spawn(function()
        while not Unloading do
            task.wait(2)

            if UnlockAllSkinsEnabled then
                pcall(function()
                    local PlayerFolder = ReplicatedStorage:FindFirstChild("Players")
                    local LocalFolder = PlayerFolder and PlayerFolder:FindFirstChild(player.Name)
                    local Purchases = LocalFolder and LocalFolder:FindFirstChild("Status")
                        and LocalFolder.Status:FindFirstChild("Purchases")
                    if not Purchases then
                        return
                    end

                    local Skins = Purchases:FindFirstChild("Skins")
                    if not Skins then
                        Skins = Instance.new("Folder")
                        Skins.Name = "Skins"
                        Skins.Parent = Purchases
                    end

                    local function UnlockFrom(FolderName)
                        local SkinFolder = ReplicatedStorage:FindFirstChild(FolderName)
                        if not SkinFolder then
                            return
                        end

                        for _, WeaponSkins in ipairs(SkinFolder:GetChildren()) do
                            local WeaponFolder = Skins:FindFirstChild(WeaponSkins.Name)
                            if not WeaponFolder then
                                WeaponFolder = Instance.new("Folder")
                                WeaponFolder.Name = WeaponSkins.Name
                                WeaponFolder.Parent = Skins
                            end

                            for _, Skin in ipairs(WeaponSkins:GetChildren()) do
                                if not WeaponFolder:FindFirstChild(Skin.Name) then
                                    local MockSkin = Instance.new("Folder")
                                    MockSkin.Name = Skin.Name
                                    MockSkin.Parent = WeaponFolder
                                end
                            end
                        end
                    end

                    UnlockFrom("Skins")
                    UnlockFrom("SkinPacks")
                end)
            end
        end
    end)

    -- Apply the selected local skin to the equipped weapon and viewmodel.
    task.spawn(function()
        local FunctionLibrary

        while not Unloading do
            task.wait(0.1)

            if UnlockAllSkinsEnabled then
                pcall(function()
                    local PlayerFolder = ReplicatedStorage:FindFirstChild("Players")
                    local LocalFolder = PlayerFolder and PlayerFolder:FindFirstChild(player.Name)
                    local Inventory = LocalFolder and LocalFolder:FindFirstChild("Inventory")
                    local Holding = LocalFolder and LocalFolder:FindFirstChild("Holding")
                    local ActiveWeapon = Holding and Holding.Value
                    if not Inventory or not ActiveWeapon or not ActiveWeapon:IsA("ObjectValue") then
                        return
                    end

                    local WeaponObject = ActiveWeapon.Value
                    local WeaponName = WeaponObject and WeaponObject.Name
                    if not WeaponObject or not WeaponName then
                        return
                    end

                    for _, Item in ipairs(Inventory:GetChildren()) do
                        if Item:IsA("ObjectValue") and Item.Value == WeaponObject then
                            local SpoofedSkin = Item:GetAttribute("SpoofedSkin")
                            if SpoofedSkin == nil then
                                return
                            end

                            local TargetSkin = SpoofedSkin == "" and nil or tostring(SpoofedSkin)
                            if WeaponObject:GetAttribute("Skin") ~= TargetSkin then
                                WeaponObject:SetAttribute("Skin", TargetSkin)
                            end

                            if not FunctionLibrary then
                                FunctionLibrary = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("FunctionLibraryExtension"))
                            end

                            local function ApplyTo(parent)
                                if not parent then
                                    return
                                end

                                local WeaponModel = parent:FindFirstChild(WeaponName)
                                local AppliedSkin = TargetSkin or "__default"
                                if WeaponModel and WeaponModel:IsA("Model")
                                    and WeaponModel:GetAttribute("SpoofSkinApplied") ~= AppliedSkin
                                then
                                    FunctionLibrary:UpdateSkin(nil, WeaponModel, TargetSkin)
                                    WeaponModel:SetAttribute("SpoofSkinApplied", AppliedSkin)
                                end
                            end

                            ApplyTo(player.Character)
                            local Camera = workspace.CurrentCamera
                            if Camera then
                                for _, Child in ipairs(Camera:GetChildren()) do
                                    if Child:GetAttribute("Temp") or Child.Name == player.Name then
                                        ApplyTo(Child)
                                    end
                                end
                            end
                            break
                        end
                    end
                end)
            end
        end
    end)
end

