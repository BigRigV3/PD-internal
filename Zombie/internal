local function RemoveZombieNametag(Zombie)
    local Nametag = ZombieNametags[Zombie]
    if not Nametag then
        return
    end

    pcall(function()
        Nametag.Visible = false
        Nametag:Remove()
    end)
    ZombieNametags[Zombie] = nil
end

local function ClearZombieESP()
    for Zombie in pairs(ZombieNametags) do
        RemoveZombieNametag(Zombie)
    end
end

local function GetZombieNametagPosition(Zombie)
    if Zombie:IsA("Model") then
        local Head = Zombie:FindFirstChild("Head", true)
        if Head and Head:IsA("BasePart") then
            return Head.Position + Vector3.new(0, 2.5, 0)
        end

        local Success, BoxCFrame, BoxSize = pcall(function()
            return Zombie:GetBoundingBox()
        end)
        if Success and BoxCFrame and BoxSize then
            return BoxCFrame.Position + Vector3.new(0, BoxSize.Y / 2 + 1.5, 0)
        end
    elseif Zombie:IsA("BasePart") then
        return Zombie.Position + Vector3.new(0, Zombie.Size.Y / 2 + 1.5, 0)
    end

    return nil
end

local function GetZombieNametag(Zombie)
    local Nametag = ZombieNametags[Zombie]
    if Nametag then
        return Nametag
    end

    local Success, NewNametag = pcall(function()
        return Drawing.new("Text")
    end)
    if not Success or not NewNametag then
        return nil
    end

    NewNametag.Center = true
    NewNametag.Outline = true
    NewNametag.OutlineColor = Color3.fromRGB(0, 0, 0)
    NewNametag.Size = 13
    NewNametag.Color = Color3.fromRGB(255, 110, 110)
    NewNametag.Visible = false
    ZombieNametags[Zombie] = NewNametag
    return NewNametag
end

local function UpdateZombieESP()
    local Camera = workspace.CurrentCamera
    local ZombiesFolder = workspace:FindFirstChild("Zombies")
    local ActiveZombies = {}

    if ZombieESPEnabled and Camera and ZombiesFolder then
        for _, Zombie in ipairs(ZombiesFolder:GetChildren()) do
            local Position = GetZombieNametagPosition(Zombie)
            if Position then
                local Nametag = GetZombieNametag(Zombie)
                if Nametag then
                    local ScreenPosition, OnScreen = Camera:WorldToViewportPoint(Position)
                    Nametag.Text = Zombie.Name
                    Nametag.Position = Vector2.new(ScreenPosition.X, ScreenPosition.Y)
                    Nametag.Visible = OnScreen and ScreenPosition.Z > 0
                    ActiveZombies[Zombie] = true
                end
            end
        end
    end

    for Zombie in pairs(ZombieNametags) do
        if not ActiveZombies[Zombie] then
            RemoveZombieNametag(Zombie)
        end
    end
end

local function SetZombieESPEnabled(Value)
    ZombieESPEnabled = Value == true
    if not ZombieESPEnabled then
        ClearZombieESP()
        return
    end

    UpdateZombieESP()
end

