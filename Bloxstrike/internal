    local function AddLocalChams(Part, Color)
        local Highlight = LocalChamsHighlights[Part]
        if not Highlight or not Highlight.Parent then
            Highlight = Instance.new("Highlight")
            Highlight.Name = "TypeshitLocalChams"
            Highlight.Parent = Library.Holder.Instance
            LocalChamsHighlights[Part] = Highlight
        end

        Highlight.Adornee = Part
        Highlight.FillColor = Color
        Highlight.OutlineColor = Color
        Highlight.FillTransparency = 0.35
        Highlight.OutlineTransparency = 0
        Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    end

    local function UpdateLocalChams(DeltaTime)
        LocalChamsRefresh = LocalChamsRefresh + DeltaTime
        if LocalChamsRefresh < 0.1 then
            return
        end
        LocalChamsRefresh = 0

        if not SelfChamsEnabled and not ArmChamsEnabled then
            if next(LocalChamsHighlights) then
                ClearLocalChams()
            end
            return
        end

        local Desired = {}
        local Character = GetBloxstrikeCharacter(LocalChamsPlayer)
        if SelfChamsEnabled and Character then
            for _, Part in ipairs(Character:GetDescendants()) do
                if Part:IsA("BasePart")
                    and Part.Transparency < 1
                    and not IsExcludedLocalPart(Part, Character)
                then
                    Desired[Part] = true
                    AddLocalChams(Part, SelfChamsColor)
                end
            end
        end

        if ArmChamsEnabled then
            local Camera = workspace.CurrentCamera
            local Viewmodel = Camera and Camera:FindFirstChildOfClass("Model")
            if Viewmodel then
                for _, Part in ipairs(Viewmodel:GetDescendants()) do
                    if Part:IsA("BasePart")
                        and Part.Transparency < 1
                        and IsArmPart(Part, Viewmodel)
                    then
                        Desired[Part] = true
                        AddLocalChams(Part, ArmChamsColor)
                    end
                end
            end
        end

        for Part, Highlight in pairs(LocalChamsHighlights) do
            if not Desired[Part] or not Part.Parent then
                pcall(function()
                    Highlight:Destroy()
                end)
                LocalChamsHighlights[Part] = nil
            end
        end
    end

