    local function NewDrawing(Class)
        local Success, Object = pcall(function()
            return Drawing.new(Class)
        end)
        return Success and Object or nil
    end

    local function SetDrawingVisible(Object, Visible)
        if Object then
            pcall(function()
                Object.Visible = Visible == true
            end)
        end
    end

    local function RemoveDrawing(Object)
        if not Object then
            return
        end

        pcall(function()
            Object.Visible = false
        end)
        pcall(function()
            Object:Remove()
        end)
        pcall(function()
            Object:Destroy()
        end)
    end

    local function HideDrawingPlayer(Objects)
        if not Objects then
            return
        end

        for Name, Object in pairs(Objects) do
            if Name == "Bones" then
                for _, Bone in ipairs(Object) do
                    SetDrawingVisible(Bone, false)
                end
            elseif Name ~= "Chams" then
                SetDrawingVisible(Object, false)
            end
        end

        if Objects.Chams then
            pcall(function()
                Objects.Chams.Enabled = false
            end)
        end
    end

    local function RemoveDrawingPlayer(Player)
        local Objects = DrawingPlayers[Player]
        if not Objects then
            return
        end

        for Name, Object in pairs(Objects) do
            if Name == "Bones" then
                for _, Bone in ipairs(Object) do
                    RemoveDrawing(Bone)
                end
            else
                RemoveDrawing(Object)
            end
        end

        DrawingPlayers[Player] = nil
    end

    local function CreateDrawingPlayer(Player)
        if DrawingPlayers[Player] then
            return DrawingPlayers[Player]
        end

        local Objects = {
            BoxOutline = NewDrawing("Square"),
            Box = NewDrawing("Square"),
            Name = NewDrawing("Text"),
            Distance = NewDrawing("Text"),
            Weapon = NewDrawing("Text"),
            HealthOutline = NewDrawing("Square"),
            Health = NewDrawing("Square"),
            Bones = {}
        }

        for _, Object in pairs(Objects) do
            if Object and Object ~= Objects.Bones then
                pcall(function()
                    Object.Visible = false
                end)
            end
        end

        for _ = 1, 15 do
            local Bone = NewDrawing("Line")
            if Bone then
                pcall(function()
                    Bone.Thickness = 1
                    Bone.Transparency = 1
                    Bone.Visible = false
                end)
                table.insert(Objects.Bones, Bone)
            end
        end

        if Library.Holder and Library.Holder.Instance then
            local Success, Chams = pcall(function()
                local Highlight = Instance.new("Highlight")
                Highlight.Name = "BloxstrikeDrawingChams"
                Highlight.Enabled = false
                Highlight.Parent = Library.Holder.Instance
                return Highlight
            end)
            if Success then
                Objects.Chams = Chams
            end
        end

        local BoxOutline = Objects.BoxOutline
        local Box = Objects.Box
        local Name = Objects.Name
        local Distance = Objects.Distance
        local Weapon = Objects.Weapon
        local HealthOutline = Objects.HealthOutline
        local Health = Objects.Health

        pcall(function()
            BoxOutline.Thickness = 2
