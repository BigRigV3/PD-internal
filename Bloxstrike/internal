            Health.Transparency = 1
        end)

        DrawingPlayers[Player] = Objects
        return Objects
    end

    local function GetDrawingWeaponName(Character)
        for _, Descendant in ipairs(Character:GetDescendants()) do
            if Descendant:IsA("Tool") then
                return Descendant.Name
            end
        end
        return "none"
    end

    local function GetDrawingBodyParts(Character)
        local Head = Character:FindFirstChild("Head")
        local Root = Character:FindFirstChild("HumanoidRootPart")
            or Character:FindFirstChild("UpperTorso")
            or Character.PrimaryPart
        local Foot = Character:FindFirstChild("LeftFoot")
            or Character:FindFirstChild("RightFoot")
            or Character:FindFirstChild("Left Leg")
            or Character:FindFirstChild("Right Leg")

        if not Foot and Root then
            return Head, Root, Root.Position - Vector3.new(0, 3, 0)
        end

        return Head, Root, Foot and Foot.Position or (Root and Root.Position)
    end

    local function RenderDrawingESP()
        Camera = workspace.CurrentCamera
        local ActivePlayers = {}

        if DrawingESPEnabled and Camera then
            for _, Player in ipairs(Players:GetPlayers()) do
                local Objects = CreateDrawingPlayer(Player)
                ActivePlayers[Player] = true

                if Player == Players.LocalPlayer and not ESP.SelfCheck then
                    HideDrawingPlayer(Objects)
                else
                    local Character = GetBloxstrikeCharacter(Player)
                    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
                    local Root = Character and (
                        Character:FindFirstChild("HumanoidRootPart")
                        or Character:FindFirstChild("UpperTorso")
                        or Character.PrimaryPart
                    )
                    local SameTeam = IsBloxstrikeSameTeam(Players.LocalPlayer, Player)
                    local DistanceInStuds = Root and (Camera.CFrame.Position - Root.Position).Magnitude
                    local MaxDistanceInStuds = (ESP.MaxDistance or 200) * 3.5714285714

                    local Allowed = Character
                        and Humanoid
                        and Root
                        and Humanoid.Health > 0
                        and (Player == Players.LocalPlayer or not (ESP.TeamCheck and SameTeam))
                        and DistanceInStuds <= MaxDistanceInStuds

                    if not Allowed then
                        HideDrawingPlayer(Objects)
                    else
                        local Head, BodyRoot, FootPosition = GetDrawingBodyParts(Character)
                        local RootPosition, RootOnScreen = Camera:WorldToViewportPoint(BodyRoot.Position)
                        local HeadPosition = Head
                            and Camera:WorldToViewportPoint(Head.Position)
                            or Camera:WorldToViewportPoint(BodyRoot.Position + Vector3.new(0, 2, 0))
                        local LegPosition = Camera:WorldToViewportPoint(FootPosition)

                        if not RootOnScreen or RootPosition.Z <= 0 then
                            HideDrawingPlayer(Objects)
                        else
                            local Height = math.max(math.abs(HeadPosition.Y - LegPosition.Y), 1)
                            local Width = math.max(Height / 1.6, 1)
                            local BoxX = RootPosition.X - Width / 2
                            local BoxY = HeadPosition.Y
                            local BoxSize = Vector2.new(Width, Height)
                            local BoxPosition = Vector2.new(BoxX, BoxY)
                            local OutlineColor = ESP.Drawing.Boxes.Full.RGB
                            local FillColor = ESP.Drawing.Boxes.Filled.RGB
                            local NameColor = ESP.Drawing.Names.RGB
                            local DistanceColor = ESP.Drawing.Distances.RGB
                            local HealthColor = ESP.Drawing.Healthbar.HealthTextRGB
                            local FontSize = ESP.FontSize or 11

                            pcall(function()
                                Objects.BoxOutline.Color = OutlineColor
                                Objects.BoxOutline.Size = BoxSize
                                Objects.BoxOutline.Position = BoxPosition
                                Objects.BoxOutline.Thickness = 2
                                Objects.BoxOutline.Visible = ESP.Drawing.Boxes.Full.Enabled
                            end)
                            pcall(function()
                                Objects.Box.Color = FillColor
                                Objects.Box.Size = BoxSize
                                Objects.Box.Position = BoxPosition
                                Objects.Box.Transparency = math.clamp(1 - (ESP.Drawing.Boxes.Filled.Transparency or 0.75), 0, 1)
                                Objects.Box.Visible = ESP.Drawing.Boxes.Filled.Enabled
                            end)

                            pcall(function()
                                Objects.Name.Size = FontSize
                                Objects.Name.Color = NameColor
                                Objects.Name.Text = Player.Name
                                Objects.Name.Position = Vector2.new(RootPosition.X, BoxY - 15)
                                Objects.Name.Visible = ESP.Drawing.Names.Enabled
                            end)

                            pcall(function()
                                Objects.Distance.Size = FontSize
                                Objects.Distance.Color = DistanceColor
                                Objects.Distance.Text = string.format("%dm", math.floor(DistanceInStuds / 3.5714285714))
                                Objects.Distance.Position = Vector2.new(RootPosition.X, BoxY + Height + 2)
                                Objects.Distance.Visible = ESP.Drawing.Distances.Enabled
                            end)

                            pcall(function()
                                Objects.Weapon.Size = FontSize
                                Objects.Weapon.Color = ESP.Drawing.Weapons.WeaponTextRGB
                                Objects.Weapon.Text = GetDrawingWeaponName(Character)
                                Objects.Weapon.Position = Vector2.new(RootPosition.X, BoxY + Height + FontSize + 2)
                                Objects.Weapon.Visible = ESP.Drawing.Weapons.Enabled and not ESP.Drawing.Weapons.Icons
                            end)

                            local HealthPercent = math.clamp(Humanoid.Health / math.max(Humanoid.MaxHealth, 1), 0, 1)
                            local HealthHeight = Height * HealthPercent
                            local HealthX = BoxX - 5
                            local LowColor = ESP.Drawing.Healthbar.GradientRGB1
                            local MidColor = ESP.Drawing.Healthbar.GradientRGB2
                            local HighColor = ESP.Drawing.Healthbar.GradientRGB3
                            if HealthPercent < 0.5 then
                                HealthColor = LowColor:Lerp(MidColor, HealthPercent * 2)
                            else
                                HealthColor = MidColor:Lerp(HighColor, (HealthPercent - 0.5) * 2)
                            end

                            pcall(function()
                                Objects.HealthOutline.Position = Vector2.new(HealthX - 1, BoxY - 1)
                                Objects.HealthOutline.Size = Vector2.new(4, Height + 2)
                                Objects.HealthOutline.Visible = ESP.Drawing.Healthbar.Enabled
                                Objects.Health.Position = Vector2.new(HealthX, BoxY + Height - HealthHeight)
                                Objects.Health.Size = Vector2.new(2, HealthHeight)
                                Objects.Health.Color = HealthColor
                                Objects.Health.Visible = ESP.Drawing.Healthbar.Enabled
                            end)

                            if Objects.Chams then
                                pcall(function()
                                    Objects.Chams.Adornee = Character
                                    Objects.Chams.FillColor = ESP.Drawing.Chams.FillRGB
                                    Objects.Chams.OutlineColor = ESP.Drawing.Chams.OutlineRGB
                                    Objects.Chams.FillTransparency = math.clamp((ESP.Drawing.Chams.Fill_Transparency or 100) * 0.01, 0, 1)
                                    Objects.Chams.OutlineTransparency = math.clamp((ESP.Drawing.Chams.Outline_Transparency or 100) * 0.01, 0, 1)
                                    Objects.Chams.DepthMode = ESP.Drawing.Chams.VisibleCheck
                                        and Enum.HighlightDepthMode.Occluded
                                        or Enum.HighlightDepthMode.AlwaysOnTop
                                    Objects.Chams.Enabled = ESP.Drawing.Chams.Enabled == true
                                end)
                            end
                        end
                    end
                end
            end
        end

        for Player in pairs(DrawingPlayers) do
            if not ActivePlayers[Player] then
                RemoveDrawingPlayer(Player)
            end
        end
    end

    ClearDrawingESP = function()
        for Player in pairs(DrawingPlayers) do
            RemoveDrawingPlayer(Player)
        end
    end

    UpdateDrawingESP = RenderDrawingESP
    Library:Connect(game:GetService("RunService").RenderStepped, RenderDrawingESP)
end

