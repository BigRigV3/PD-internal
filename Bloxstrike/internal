local function GetBloxstrikeCharacter(Player)
    if not Player then
        return nil
    end

    -- Bloxstrike exposes the live character through Player.Character. Do not
    -- search recursively: weapon/viewmodel models can be nested below the
    -- workspace character container and are not valid ESP targets.
    local Character = Player.Character
    if Character and Character:IsA("Model") and Character:FindFirstChildOfClass("Humanoid") then
        return Character
    end

    -- Fallback for respawn frames where Player.Character has not replicated
    -- yet. Only accept an exact direct child with a Humanoid.
    local Characters = workspace:FindFirstChild("Characters")
    if not Characters then
        return nil
    end

    local Fallback = Characters:FindFirstChild(Player.Name)
    if Fallback and Fallback:IsA("Model") and Fallback:FindFirstChildOfClass("Humanoid") then
        return Fallback
    end

    return nil
end

local function GetBloxstrikeTeam(Player)
    if not Player then
        return nil
    end

    local Character = GetBloxstrikeCharacter(Player)
    local PlayerTeam = Player.Team
    if PlayerTeam and (PlayerTeam.Name == "Terrorists" or PlayerTeam.Name == "Counter-Terrorists") then
        return PlayerTeam.Name
    end

    local AttributeTeam = Character and Character:GetAttribute("Team")
    if AttributeTeam == "Terrorists" or AttributeTeam == "Counter-Terrorists" then
        return AttributeTeam
    end

    local ParentName = Character and Character.Parent and Character.Parent.Name
    if ParentName == "Terrorists" or ParentName == "Counter-Terrorists" then
        return ParentName
    end

    return PlayerTeam and PlayerTeam.Name or nil
end

local function IsBloxstrikeSameTeam(LeftPlayer, RightPlayer)
    local LeftTeam = GetBloxstrikeTeam(LeftPlayer)
    local RightTeam = GetBloxstrikeTeam(RightPlayer)

    if LeftTeam and RightTeam then
        return LeftTeam == RightTeam
    end

    return LeftPlayer.Team ~= nil and LeftPlayer.Team == RightPlayer.Team
end

