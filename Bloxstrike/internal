local function LoadScript(Url, LocalPath)
    local Source

    if LocalPath and type(isfile) == "function" and type(readfile) == "function" then
        local LocalPaths = {LocalPath}
        local NormalizedPath = string.gsub(LocalPath, "\\\\", "/")
        local BaseName = string.match(NormalizedPath, "[^/]+$")

        if NormalizedPath ~= LocalPath then
            table.insert(LocalPaths, NormalizedPath)
        end
        if BaseName and BaseName ~= LocalPath then
            table.insert(LocalPaths, BaseName)
        end

        for _, Path in ipairs(LocalPaths) do
            local Ok, Result = pcall(function()
                if isfile(Path) then
                    return readfile(Path)
                end
            end)

            if Ok and type(Result) == "string" and #Result > 0 then
                Source = Result
                break
            end
        end
    end

    local Urls = {Url}
    local MainUrl = string.gsub(Url, "/refs/heads/main/", "/main/")
    if MainUrl ~= Url then
        table.insert(Urls, MainUrl)
    end

    for _, CandidateUrl in ipairs(Urls) do
        for _ = 1, 3 do
            if Source then
                break
            end

            local Ok, Result = pcall(function()
                return game:HttpGet(CandidateUrl)
            end)
            if Ok and type(Result) == "string" and #Result > 0 and not string.find(Result, "^%d%d%d: ") then
                Source = Result
                break
            end
            task.wait(1)
        end

        if Source then
            break
        end
    end

    assert(Source, "failed to load " .. tostring(LocalPath or Url) .. " (local file unavailable and HTTP sources failed)")
    if string.find(string.lower(Url), "/esplib$") then
        local FirstReturn = string.find(Source, "\nreturn ESP")
        if FirstReturn then
            Source = string.sub(Source, 1, FirstReturn + #"\nreturn ESP" - 1)
        end
    end
    local Chunk, Error = loadstring(Source)
    assert(Chunk, "failed to compile " .. Url .. ": " .. tostring(Error))
    return Chunk()
end

