    local function IsSilentAimVisible(TargetPart, TargetCharacter)
        if SilentAimWallbang then
            return true
        end

        if not TargetPart or not TargetPart.Parent or not TargetCharacter then
            return false
        end

        local LocalCharacter = GetBloxstrikeCharacter(LocalPlayer)
        RaycastParameters.FilterDescendantsInstances = LocalCharacter and {LocalCharacter} or {}

        local Origin = workspace.CurrentCamera and workspace.CurrentCamera.CFrame.Position
        if not Origin then
            return false
        end

        local Result = Workspace:Raycast(Origin, TargetPart.Position - Origin, RaycastParameters)
        if not Result then
            return true
        end

        return Result.Instance and Result.Instance:IsDescendantOf(TargetCharacter)
    end

    local function FindSilentTarget()
        local Camera = workspace.CurrentCamera
        local LocalCharacter = GetBloxstrikeCharacter(LocalPlayer)
        if not SilentAimEnabled or not Camera or not LocalCharacter then
            SilentAimTargetPart = nil
            return
        end

        local LocalTeam = GetBloxstrikeTeam(LocalPlayer)
        local ScreenCenter = Camera.ViewportSize / 2
        local ClosestDistance = math.huge
        local ClosestPart

        for _, Player in ipairs(Players:GetPlayers()) do
            if Player ~= LocalPlayer then
                local Character = GetBloxstrikeCharacter(Player)
                local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
                local PlayerTeam = GetBloxstrikeTeam(Player)
                local SameTeam = LocalTeam ~= nil and PlayerTeam ~= nil and LocalTeam == PlayerTeam

                if Character
                    and Humanoid
                    and Humanoid.Health > 0
                    and not Character:GetAttribute("Dead")
                    and not Character:GetAttribute("Invincible")
                    and not (Character.Parent and Character.Parent.Name == "Debris")
                    and (not SilentAimTeamCheck or not SameTeam)
                then
                    local CandidateParts = {}
                    if LegitSilentAimEnabled then
                        local HitboxNames = {
                            head = true,
                            torso = true,
                            uppertorso = true,
                            lowertorso = true,
                            humanoidrootpart = true,
                            ["left arm"] = true,
                            ["right arm"] = true,
                            ["left leg"] = true,
                            ["right leg"] = true,
                            leftupperarm = true,
                            leftlowerarm = true,
                            lefthand = true,
                            rightupperarm = true,
                            rightlowerarm = true,
                            righthand = true,
                            leftupperleg = true,
                            leftlowerleg = true,
                            leftfoot = true,
                            rightupperleg = true,
                            rightlowerleg = true,
                            rightfoot = true
                        }

                        for _, Descendant in ipairs(Character:GetDescendants()) do
                            local PartName = string.lower(Descendant.Name)
                            if Descendant:IsA("BasePart")
                                and (HitboxNames[PartName] or string.find(PartName, "hitbox", 1, true))
                            then
                                local Ancestor = Descendant.Parent
                                local Excluded = false
                                while Ancestor and Ancestor ~= Character do
                                    if Ancestor:IsA("Accessory") or Ancestor:IsA("Tool") then
                                        Excluded = true
                                        break
                                    end
                                    Ancestor = Ancestor.Parent
                                end

                                if not Excluded then
                                    table.insert(CandidateParts, Descendant)
                                end
                            end
                        end
                    else
                        local TargetPart = Character:FindFirstChild(SilentAimPartName)
                            or Character:FindFirstChild("Head")
                            or Character:FindFirstChild("HumanoidRootPart")
                            or Character.PrimaryPart
                        if TargetPart and TargetPart:IsA("BasePart") then
                            table.insert(CandidateParts, TargetPart)
                        end
                    end

                    for _, TargetPart in ipairs(CandidateParts) do
                        local ScreenPosition, OnScreen = Camera:WorldToViewportPoint(TargetPart.Position)
                        if OnScreen and ScreenPosition.Z > 0 then
                            local Distance = (Vector2.new(ScreenPosition.X, ScreenPosition.Y) - ScreenCenter).Magnitude
                            local MaxRadius = SilentAimUseFOV and SilentAimFOVRadius or math.huge

                            if Distance <= MaxRadius
                                and Distance < ClosestDistance
                                and IsSilentAimVisible(TargetPart, Character)
                            then
                                ClosestDistance = Distance
                                ClosestPart = TargetPart
                            end
                        end
                    end
                end
            end
        end

        SilentAimTargetPart = ClosestPart
    end

    Library:Connect(RunService.RenderStepped, FindSilentTarget)

    local SilentAimRaycastFunction
    local SilentAimOldRaycastFunction
    local SilentAimHookInstalled = false

    local function InstallSilentAimHook()
        if Unloading or SilentAimHookInstalled or type(hookfunction) ~= "function" or type(getgc) ~= "function" then
            return SilentAimHookInstalled
        end

        local BulletClass
        for _ = 1, 45 do
            if Unloading then
                return false
            end

            local Success, Garbage = pcall(getgc, true)
            if Success and type(Garbage) == "table" then
                for _, Object in next, Garbage do
                    if type(Object) == "table"
                        and type(rawget(Object, "_performRaycast")) == "function"
                        and rawget(Object, "getTrueSpread") ~= nil
                    then
                        BulletClass = Object
                        break
                    end
                end
            end

            if BulletClass then
                break
            end
            task.wait(0.5)
        end

        SilentAimRaycastFunction = BulletClass and rawget(BulletClass, "_performRaycast")
        if type(SilentAimRaycastFunction) ~= "function" then
            return false
        end

        local OldRaycast
        local Hook = function(...)
            local Returns = table.pack(OldRaycast(...))
            local Result = Returns[1]

            if SilentAimEnabled and SilentAimTargetPart and type(Result) == "table" then
                pcall(function()
                    local Hits = rawget(Result, "Hits")
                    if type(Hits) ~= "table" or not SilentAimTargetPart.Parent then
                        return
                    end

                    local AimPosition = SilentAimTargetPart.Position
                    local LastIndex
                    for Index, Hit in pairs(Hits) do
                        if type(Hit) == "table" and (LastIndex == nil or Index > LastIndex) then
                            LastIndex = Index
                        end
                    end

                    local FinalHit = LastIndex and Hits[LastIndex]
                    if type(FinalHit) ~= "table" then
                        return
                    end

                    FinalHit.Instance = SilentAimTargetPart
                    FinalHit.Position = AimPosition
                    if FinalHit.Exit ~= nil then
                        FinalHit.Exit = false
                    end

                    local Origin = rawget(Result, "Origin")
                    if typeof(Origin) == "Vector3" then
                        local Delta = AimPosition - Origin
                        local Length = Delta.Magnitude
                        if Length > 0.001 then
                            Result.Distance = Length
                            Result.Direction = Delta.Unit

                            local Unit = Delta.Unit
                            for Index, Hit in pairs(Hits) do
                                if Index ~= LastIndex
                                    and type(Hit) == "table"
                                    and typeof(Hit.Position) == "Vector3"
                                then
                                    local Along = (Hit.Position - Origin):Dot(Unit)
                                    if Along > Length then
                                        Hit.Position = Origin + Unit * (Length * 0.5)
                                    end
                                end
                            end
                        end
                    end
                end)
            end

            return table.unpack(Returns, 1, Returns.n)
        end

        local Success, Previous = pcall(function()
            return hookfunction(SilentAimRaycastFunction, Hook)
        end)
        if not Success or type(Previous) ~= "function" then
            SilentAimRaycastFunction = nil
            return false
        end

        SilentAimOldRaycastFunction = Previous
        OldRaycast = Previous
        SilentAimHookInstalled = true
        return true
    end

    RestoreSilentAimHook = function()
        if SilentAimHookInstalled
            and type(hookfunction) == "function"
            and SilentAimRaycastFunction
            and SilentAimOldRaycastFunction
        then
            pcall(function()
                hookfunction(SilentAimRaycastFunction, SilentAimOldRaycastFunction)
            end)
        end

        SilentAimHookInstalled = false
        SilentAimRaycastFunction = nil
        SilentAimOldRaycastFunction = nil
    end

    task.spawn(function()
        InstallSilentAimHook()
    end)
end

