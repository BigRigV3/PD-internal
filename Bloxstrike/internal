            Ancestor = Ancestor.Parent
        end
        return false
    end

    local function IsArmPart(Part, Viewmodel)
        local PartName = string.lower(Part.Name)
        if string.find(PartName, "arm", 1, true) or string.find(PartName, "hand", 1, true) then
            return true
        end

        local Ancestor = Part.Parent
        while Ancestor and Ancestor ~= Viewmodel do
            if Ancestor:IsA("Model")
                and (Ancestor:FindFirstChild("LL") or Ancestor:FindFirstChild("LH"))
